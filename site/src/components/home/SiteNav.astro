---
import { homeCopy } from '../../content/home';
import { altUrl, t, type Locale } from '../../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = homeCopy[locale].nav;
const other: Locale = locale === 'es' ? 'en' : 'es';
const home = altUrl(locale, '');
const links = [
  { href: `${home}#how`, label: c.how },
  { href: `${home}#system`, label: c.stays },
  { href: `${home}#installs`, label: c.installs },
  { href: altUrl(locale, 'industrial'), label: c.business },
  { href: `${home}#dealers`, label: c.dealers },
  { href: altUrl(locale, 'faq'), label: c.faq },
];
---
<a class="skip" href="#main">{t(locale, 'common.skip_to_content')}</a>
<header class="sn">
  <div class="sn__in">
    <a class="sn__brand" href={home} aria-label={t(locale, 'nav.home_aria')}>
      <img src="/assets/brand/firefly-logo-ondark.svg" alt="Firefly Energy" width="124" height="30" />
    </a>
    <nav class="sn__links" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="sn__right">
      <a class="sn__lang" href={altUrl(other, '')} hreflang={other} aria-label={t(locale, 'common.locale_aria')}>{t(locale, 'common.locale_label')}</a>
      <a class="btn btn--primary sn__cta" href={altUrl(locale, 'calculator')} data-track="begin_assessment">{c.cta}</a>
      <details class="sn__menu">
        <summary aria-label={t(locale, 'common.menu')}><span></span><span></span></summary>
        <div class="sn__sheet">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
          <a class="btn btn--primary" href={altUrl(locale, 'calculator')} data-track="begin_assessment">{c.cta}</a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .skip { position: absolute; left: 1rem; top: -4rem; z-index: 100; padding: .6rem 1rem; border-radius: 8px; background: var(--ff-green); color: var(--ff-ink); font-weight: 600; }
  .skip:focus { top: 1rem; }
  .sn { position: fixed; inset: 0 0 auto; z-index: 50; height: var(--nav-h); color: var(--on-night);
    background: linear-gradient(rgb(11 13 16 / 0.72), rgb(11 13 16 / 0.45)); backdrop-filter: blur(12px) saturate(140%);
    border-bottom: 1px solid var(--night-line); }
  .sn__in { height: 100%; width: min(100% - 2 * var(--gutter), var(--wide)); margin-inline: auto; display: flex; align-items: center; gap: 2rem; }
  .sn__brand { display: flex; flex-shrink: 0; }
  .sn__links { display: flex; gap: 1.75rem; margin-right: auto; }
  .sn__links a, .sn__lang { color: var(--on-night-2); text-decoration: none; font-size: .95rem; font-weight: 500; transition: color .2s; }
  .sn__links a:hover, .sn__lang:hover { color: var(--on-night); }
  .sn__right { display: flex; align-items: center; gap: 1.25rem; margin-left: auto; }
  .sn__lang { font-weight: 700; letter-spacing: .04em; padding: .5rem; }
  .sn__cta { min-height: 42px; padding: .6rem 1.1rem; font-size: .92rem; }
  .sn__menu { display: none; position: relative; }
  .sn__menu summary { list-style: none; width: 44px; height: 44px; display: grid; place-content: center; gap: 6px; cursor: pointer; }
  .sn__menu summary::-webkit-details-marker { display: none; }
  .sn__menu summary span { width: 22px; height: 2px; background: var(--on-night); border-radius: 2px; transition: transform .3s var(--ease); }
  .sn__menu[open] summary span:first-child { transform: translateY(4px) rotate(45deg); }
  .sn__menu[open] summary span:last-child { transform: translateY(-4px) rotate(-45deg); }
  .sn__sheet { position: fixed; top: var(--nav-h); left: 0; right: 0; display: grid; gap: .25rem; padding: 1rem var(--gutter) 1.5rem;
    background: rgb(11 13 16 / 0.97); border-bottom: 1px solid var(--night-line); }
  .sn__sheet a:not(.btn) { color: var(--on-night); text-decoration: none; font-size: 1.15rem; padding: .8rem 0; border-bottom: 1px solid var(--night-line); }
  .sn__sheet .btn { margin-top: 1rem; }
  @media (max-width: 1060px) { .sn__links { display: none; } }
  @media (max-width: 640px) { .sn__cta { display: none; } .sn__menu { display: block; } .sn__right { gap: .25rem; } }
</style>
