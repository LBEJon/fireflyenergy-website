---
import { homeCopy } from '../../content/home';
import { altUrl, t, type Locale } from '../../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = homeCopy[locale].hero;
const wa = `https://wa.me/${t(locale, 'common.whatsapp')}`;
---
<!--
  Hero film (~19 s, muted, plays once on load): San Miguel lit → rolling blackout → only the Firefly home
  stays on → drone flies down to its door and into the hall where the Firefly is running. Holds on the last
  frame with a replay button. Reduced motion, data saver, or blocked autoplay → the last frame as a still.
-->
<section class="nh" data-nh aria-labelledby="nh-title">
  <div class="nh__stage">
    <div class="nh__media">
    <picture class="nh__still">
      <source srcset="/assets/video/hero-end-mobile.webp?v=3" media="(max-width: 700px)" type="image/webp" />
      <img src="/assets/video/hero-end.webp?v=3" alt={c.insideAlt} width="1920" height="1080" decoding="async" />
    </picture>
    <video class="nh__video" muted playsinline preload="auto" poster="/assets/video/hero-start.webp" aria-label={c.videoLabel}>
      <source src="/assets/video/hero-mobile.mp4?v=3" media="(max-width: 700px)" type="video/mp4" />
      <source src="/assets/video/hero.mp4?v=3" type="video/mp4" />
    </video>
    </div>

    <div class="nh__copy">
      <h1 id="nh-title" class="nh__title">
        <span>{c.h1a}</span>
        <span class="nh__title-b">{c.h1b}</span>
      </h1>
      <p class="nh__sub">{c.sub}</p>
      <div class="nh__actions">
        <a class="btn btn--primary" href={altUrl(locale, 'calculator')} data-track="begin_assessment">{c.cta}</a>
        <a class="btn btn--ghost-dark" href={wa} target="_blank" rel="noopener" data-track="contact_whatsapp">{c.wa}</a>
      </div>
      <ul class="nh__trust">
        {c.trust.map((x) => <li>{x}</li>)}
      </ul>
    </div>

    <button class="nh__replay" type="button" hidden>
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 5V2L7 6l5 4V7a5 5 0 1 1-5 5H5a7 7 0 1 0 7-7z"/></svg>
      {c.replay}
    </button>
  </div>
</section>

<style>
  .nh { position: relative; background: var(--night); color: var(--on-night); }
  .nh__stage { position: relative; height: 100vh; height: 100svh; min-height: 560px; overflow: hidden; isolation: isolate; }
  .nh__still img, .nh__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .nh__still img { object-position: 75% 50%; }
  .nh__still { display: none; }
  .nh.is-still .nh__still { display: block; }
  .nh.is-still .nh__video { display: none; }
  .nh__media { position: absolute; inset: 0; }
  .nh__media::after { /* legibility scrim, bottom-left where the copy sits */
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      linear-gradient(to top, rgb(9 10 12 / 0.9) 0%, rgb(9 10 12 / 0.5) 30%, transparent 58%),
      linear-gradient(to right, rgb(9 10 12 / 0.55), transparent 50%);
  }

  .nh__copy { position: absolute; z-index: 3; left: var(--gutter); right: var(--gutter); bottom: clamp(2rem, 7vh, 4.5rem); max-width: 46rem; }
  .nh__title {
    font-family: var(--ff-display); font-weight: 700; text-wrap: balance;
    font-size: clamp(2.75rem, 7.2vw, 6rem); line-height: .94; letter-spacing: -0.025em; margin: 0;
  }
  .nh__title span { display: block; }
  /* Second line lands as the blackout finishes and the Firefly home is the only one lit. */
  .nh__title-b { color: var(--ff-green); opacity: 0; transform: translateY(.4em); transition: opacity .9s var(--ease), transform .9s var(--ease); }
  .nh.is-on .nh__title-b { opacity: 1; transform: none; }
  .nh__sub { margin: 1.25rem 0 0; max-width: 36rem; font-size: clamp(1.02rem, 1.25vw, 1.2rem); line-height: 1.55; color: var(--on-night-2); }
  .nh__actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.75rem; }
  .nh__trust { list-style: none; display: flex; flex-wrap: wrap; gap: .4rem 1.25rem; margin: 1.25rem 0 0; padding: 0; font-size: .88rem; color: var(--on-night-2); }
  .nh__trust li { display: inline-flex; align-items: center; gap: .45rem; }
  .nh__trust li::before { content: ''; width: .4rem; height: .4rem; border-radius: 50%; background: var(--ff-green); }

  .nh__replay {
    position: absolute; z-index: 3; right: var(--gutter); bottom: clamp(2rem, 7vh, 4.5rem);
    display: inline-flex; align-items: center; gap: .45rem; min-height: 44px; padding: 0 1rem; border-radius: 999px;
    font: 600 .85rem/1 var(--ff-body, inherit); color: var(--on-night); cursor: pointer;
    background: rgb(9 10 12 / 0.55); border: 1px solid rgb(255 255 255 / 0.25); backdrop-filter: blur(6px);
  }
  .nh__replay[hidden] { display: none; }
  .nh__replay:hover { border-color: var(--ff-green); color: var(--ff-green); }

  @media (max-width: 700px) {
    /* Phones: the film sits in a 4:5 box under the nav so the story is never behind the copy. */
    .nh__stage { height: auto; min-height: 0; padding-top: var(--nav-h, 64px); }
    .nh__media { position: relative; inset: auto; height: min(125vw, 56svh); }
    .nh__media::after { background: linear-gradient(to top, var(--night) 0%, transparent 28%); }
    .nh__copy { position: relative; left: auto; right: auto; bottom: auto; margin: -2.5rem var(--gutter) 0; padding-bottom: 2.25rem; }
    .nh__title { font-size: clamp(2.3rem, 10.5vw, 3rem); }
    .nh__sub { margin-top: .9rem; font-size: 1rem; }
    .nh__actions { margin-top: 1.25rem; }
    .nh__replay { top: calc(var(--nav-h, 64px) + .75rem); bottom: auto; }
  }
  @media (prefers-reduced-motion: reduce) { .nh__title-b { transition: none; } }
</style>

<script>
  const LINE_B_AT = 4.3; // seconds: the blackout is complete
  type Tracker = { ffTrack?: (n: string, p?: object) => void };
  const track = (n: string) => (window as Tracker).ffTrack?.(n);

  document.querySelectorAll<HTMLElement>('[data-nh]').forEach((root) => {
    const v = root.querySelector<HTMLVideoElement>('.nh__video')!;
    const replay = root.querySelector<HTMLButtonElement>('.nh__replay')!;
    const still = () => root.classList.add('is-still', 'is-on');
    const saveData = (navigator as { connection?: { saveData?: boolean } }).connection?.saveData;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || saveData) return still();

    let started = false;
    v.addEventListener('playing', () => { if (!started) { started = true; track('hero_video_start'); } });
    v.addEventListener('timeupdate', () => { if (v.currentTime >= LINE_B_AT) root.classList.add('is-on'); });
    v.addEventListener('ended', () => { root.classList.add('is-on'); replay.hidden = false; track('hero_video_complete'); });
    v.addEventListener('error', still);
    replay.addEventListener('click', () => {
      replay.hidden = true;
      root.classList.remove('is-on');
      v.currentTime = 0;
      v.play().catch(still);
      track('hero_video_replay');
    });
    v.muted = true;
    v.play().catch(still); // autoplay blocked (e.g. low-power mode): show the final frame instead
  });
</script>
