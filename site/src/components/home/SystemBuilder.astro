---
import { homeCopy } from '../../content/home';
import { altUrl, type Locale } from '../../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = homeCopy[locale].system;
const MAX = 4;
---
<section class="sb" id="system" aria-labelledby="sb-title" data-sb data-hrs={c.hrs}>
  <div class="wrap">
    <header class="sb__head">
      <h2 id="sb-title" class="display h2" data-rv>{c.title}</h2>
      <p class="lede" data-rv>{c.lede}</p>
    </header>

    <div class="sb__grid">
      <figure class="sb__stage" aria-hidden="true">
        <div class="sb__floor">
          <img class="sb__inv" src="/assets/equipment/lineup/inv.webp" alt="" width="597" height="867" loading="lazy" decoding="async" />
          <div class="sb__bats">
            {c.batteries.map((b) => (
              <div class={`sb__batset sb__batset--${b.key}`}>
                {Array.from({ length: MAX }, (_, i) => (
                  <img class={`sb__bat ${i === 0 ? "is-on" : ""}`} data-n={i + 1} src={`/assets/equipment/lineup/${b.img}.webp`} alt="" loading="lazy" decoding="async" />
                ))}
              </div>
            ))}
          </div>
        </div>
        <figcaption>{c.imgNote}</figcaption>
      </figure>

      <div class="sb__panel">
        <fieldset class="sb__group">
          <legend><span>{c.invLabel}</span> <small>{c.invHint}</small></legend>
          <div class="sb__chips">
            {c.inverters.map((v) => (
              <label><input type="radio" name="sb-inv" value={v.key} checked={v.key === 'k12'} /><span>{v.chip}</span></label>
            ))}
          </div>
          {c.inverters.map((v) => (
            <div class={`sb__info sb__info--${v.key}`}>
              <h3>{v.name}</h3>
              <p>{v.fit}</p>
              <ul>{v.specs.map((x) => <li>{x}</li>)}</ul>
            </div>
          ))}
        </fieldset>

        <fieldset class="sb__group">
          <legend><span>{c.batLabel}</span> <small>{c.batHint}</small></legend>
          <div class="sb__row">
            <div class="sb__chips">
              {c.batteries.map((b) => (
                <label><input type="radio" name="sb-bat" value={b.key} data-kwh={b.kwh} checked={b.key === 'b16'} /><span>{b.chip}</span></label>
              ))}
            </div>
            <div class="sb__count" role="group" aria-label={c.count}>
              <button type="button" data-step="-1" aria-label={c.less}>−</button>
              <output data-count aria-live="polite">× 1</output>
              <button type="button" data-step="1" aria-label={c.more}>+</button>
            </div>
          </div>
          {c.batteries.map((b) => (
            <div class={`sb__info sb__info--${b.key}`}>
              <h3>{b.name}</h3>
              <p>{b.note}</p>
            </div>
          ))}
        </fieldset>

        <dl class="sb__result" aria-live="polite">
          <div><dt>{c.total}</dt><dd data-total>16 kWh</dd></div>
          <div><dt>{c.essentials}</dt><dd data-ess>{c.hrs.replace('{h}', '24')}</dd></div>
          <div><dt>{c.normal}</dt><dd data-norm>{c.hrs.replace('{h}', '14')}</dd></div>
        </dl>

        <a class="btn btn--coral sb__cta" href={altUrl(locale, 'calculator')} data-track="begin_assessment">{c.cta}</a>
        <p class="sb__fine">{c.warranty} {c.fine}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .sb { background: var(--ff-paper); padding: clamp(6rem, 14vh, 10rem) 0; }
  .sb .lede { color: var(--ff-slate); max-width: 44rem; }
  .sb__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: center; margin-top: clamp(2.5rem, 6vh, 4rem); }

  .sb__stage { margin: 0; display: grid; gap: 1rem; justify-items: center; }
  .sb__floor { position: relative; display: flex; align-items: flex-end; justify-content: center; gap: clamp(1rem, 3vw, 2.5rem);
    width: 100%; min-height: clamp(320px, 42vw, 520px); padding: 2rem 1rem 1.5rem; border-radius: 24px; overflow: hidden;
    background: radial-gradient(ellipse 70% 30% at 50% 92%, rgb(42 45 52 / 0.16), transparent 70%), linear-gradient(#fff, var(--ff-mist)); }
  .sb__inv { height: clamp(200px, 25vw, 320px); width: auto; align-self: center; filter: drop-shadow(0 18px 24px rgb(42 45 52 / 0.18)); }
  .sb__bats { display: grid; align-items: end; }
  .sb__batset { grid-area: 1 / 1; display: none; align-items: flex-end; }
  .sb:has(input[value='b5']:checked) .sb__batset--b5,
  .sb:has(input[value='b15']:checked) .sb__batset--b15,
  .sb:has(input[value='b16']:checked) .sb__batset--b16 { display: flex; }
  .sb__bat { --k: calc(1 / (1 + (var(--n, 1) - 1) * 0.28)); width: auto; filter: drop-shadow(0 18px 22px rgb(42 45 52 / 0.2)); transition: opacity .35s var(--ease), transform .45s var(--ease); }
  .sb__bat.is-on + .sb__bat.is-on { margin-left: calc(var(--w) * -0.42); }
  .sb__batset--b5 .sb__bat { --w: clamp(90px, 10vw, 135px); height: calc(clamp(140px, 16vw, 210px) * var(--k)); }
  .sb__batset--b15 .sb__bat { --w: clamp(118px, 14vw, 180px); height: calc(clamp(220px, 27vw, 340px) * var(--k)); }
  .sb__batset--b16 .sb__bat { --w: clamp(120px, 15vw, 190px); height: calc(clamp(180px, 22vw, 280px) * var(--k)); }
  .sb__bat:not(.is-on) { display: none; }
  .sb__stage figcaption { font-size: .8rem; color: var(--ff-slate); }

  .sb__group { border: 0; margin: 0 0 1.75rem; padding: 0; min-width: 0; }
  .sb__group legend { padding: 0; margin-bottom: .75rem; display: flex; align-items: baseline; gap: .6rem; flex-wrap: wrap; }
  .sb__group legend span { font-family: var(--ff-display); font-weight: 700; font-size: 1.5rem; }
  .sb__group legend small { color: var(--ff-slate); font-size: .92rem; }
  .sb__row { display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; }
  .sb__chips { display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; border: 1px solid var(--ff-line); border-radius: 999px; background: var(--ff-white); }
  .sb__chips label { position: relative; }
  .sb__chips input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .sb__chips span { display: block; padding: .65rem 1.05rem; border-radius: 999px; font-weight: 600; font-size: .95rem; color: var(--ff-slate); white-space: nowrap;
    transition: background-color .3s var(--ease), color .3s; }
  .sb__chips input:checked + span { background: var(--ff-ink); color: #fff; }
  .sb__chips input:focus-visible + span { outline: 2px solid var(--ff-green); outline-offset: 2px; }
  .sb__count { display: inline-flex; align-items: center; border: 1px solid var(--ff-line); border-radius: 999px; background: var(--ff-white); padding: 4px; }
  .sb__count button { width: 40px; height: 40px; border: 0; border-radius: 50%; background: transparent; font: 600 1.25rem/1 var(--ff-sans); color: var(--ff-ink); cursor: pointer; }
  .sb__count button:hover:not(:disabled) { background: var(--ff-mist); }
  .sb__count button:disabled { color: #c3c7bd; cursor: default; }
  .sb__count output { min-width: 2.75rem; text-align: center; font-weight: 700; font-variant-numeric: tabular-nums; }

  .sb__info { display: none; margin-top: 1rem; }
  .sb:has(input[value='k72']:checked) .sb__info--k72, .sb:has(input[value='k10']:checked) .sb__info--k10,
  .sb:has(input[value='k12']:checked) .sb__info--k12, .sb:has(input[value='k12p']:checked) .sb__info--k12p,
  .sb:has(input[value='b5']:checked) .sb__info--b5, .sb:has(input[value='b15']:checked) .sb__info--b15,
  .sb:has(input[value='b16']:checked) .sb__info--b16 { display: block; animation: sbIn .45s var(--ease); }
  @keyframes sbIn { from { opacity: 0; transform: translateY(6px); } }
  .sb__info h3 { margin: 0; font-size: 1.05rem; }
  .sb__info p { margin: .25rem 0 0; color: var(--ff-slate); line-height: 1.5; }
  .sb__info ul { margin: .6rem 0 0; padding: 0; list-style: none; display: grid; gap: .3rem; font-size: .95rem; }
  .sb__info li { display: flex; gap: .55rem; align-items: baseline; }
  .sb__info li::before { content: ''; flex: none; width: .4rem; height: .4rem; border-radius: 50%; background: var(--ff-green); transform: translateY(-.1rem); }

  .sb__result { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 2.25rem; margin: 0; padding: 1.25rem 0; border-top: 1px solid var(--ff-line); border-bottom: 1px solid var(--ff-line); }
  .sb__result dt { font-size: .82rem; color: var(--ff-slate); }
  .sb__result dd { margin: .2rem 0 0; font-family: var(--ff-display); font-weight: 700; font-size: clamp(1.9rem, 3vw, 2.6rem); line-height: 1; font-variant-numeric: tabular-nums; }
  .sb__cta { margin-top: 1.75rem; }
  .sb__fine { margin: 1rem 0 0; font-size: .84rem; line-height: 1.5; color: var(--ff-slate); max-width: 36rem; }

  @media (max-width: 960px) { .sb__grid { grid-template-columns: 1fr; } .sb__floor { min-height: 300px; } }
  @media (max-width: 480px) { .sb__result { gap: 1.25rem; } .sb__chips span { padding: .6rem .8rem; font-size: .9rem; } }
</style>

<script>
  // Battery count + runtime estimate. Essentials ≈ 0.6 kW average, normal ≈ 25 kWh/day; 90% usable.
  document.querySelectorAll<HTMLElement>('[data-sb]').forEach((root) => {
    const MAX = 4;
    const tpl = root.dataset.hrs || '~{h} hrs';
    const out = root.querySelector('[data-count]')!;
    const [less, more] = root.querySelectorAll<HTMLButtonElement>('[data-step]');
    let n = 1;
    const fmt = (h: number) => (h > 48 ? tpl.replace('~', '').replace('{h}', '48+') : tpl.replace('{h}', String(Math.max(1, Math.round(h)))));
    function update() {
      const kwh = Number(root.querySelector<HTMLInputElement>('input[name="sb-bat"]:checked')?.dataset.kwh || 16);
      const total = kwh * n;
      out.textContent = `× ${n}`;
      root.style.setProperty('--n', String(n));
      less.disabled = n <= 1; more.disabled = n >= MAX;
      root.querySelector('[data-total]')!.textContent = `${total} kWh`;
      root.querySelector('[data-ess]')!.textContent = fmt((total * 0.9) / 0.6);
      root.querySelector('[data-norm]')!.textContent = fmt((total * 0.9) / (25 / 24));
      root.querySelectorAll<HTMLElement>('.sb__bat').forEach((img) => img.classList.toggle('is-on', Number(img.dataset.n) <= n));
    }
    root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => { n = Math.min(MAX, Math.max(1, n + Number(b.dataset.step))); update(); }));
    root.querySelectorAll('input[name="sb-bat"]').forEach((i) => i.addEventListener('change', update));
    update();
  });
</script>
