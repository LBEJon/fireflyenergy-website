---
import { homeCopy } from '../../content/home';
import { altUrl, type Locale } from '../../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = homeCopy[locale].system;
const MAX = 4;
---
<section class="sb" id="system" aria-labelledby="sb-title" data-sb data-hrs={c.hrs}>
  <div class="wrap">
    <header class="sb__head">
      <h2 id="sb-title" class="display">{c.title}</h2>
      <p>{c.lede}</p>
    </header>

    <div class="sb__grid">
      <figure class="sb__stage" aria-hidden="true">
        <div class="sb__floor">
          <div class="sb__invs">
            {c.inverters.map((v) => (
              <img class={`sb__inv sb__inv--${v.key}`} src={`/assets/equipment/lineup/${v.key}.webp`} alt="" loading="lazy" decoding="async" />
            ))}
          </div>
          <div class="sb__bats">
            {c.batteries.map((b) => (
              <div class={`sb__batset sb__batset--${b.key}`}>
                {Array.from({ length: MAX }, (_, i) => (
                  <img class={`sb__bat ${i === 0 ? "is-on" : ""}`} data-n={i + 1} src={`/assets/equipment/lineup/${b.img}.webp`} alt="" loading="lazy" decoding="async" />
                ))}
              </div>
            ))}
          </div>
        </div>
      </figure>

      <div class="sb__panel">
        <fieldset class="sb__group">
          <legend><span>{c.invLabel}</span> <small>{c.invHint}</small></legend>
          <div class="sb__chips">
            {c.inverters.map((v) => (
              <label><input type="radio" name="sb-inv" value={v.key} checked={v.key === 'k12'} /><span>{v.chip}</span></label>
            ))}
          </div>
          {c.inverters.map((v) => (
            <div class={`sb__info sb__info--${v.key}`}>
              <h3>{v.name}</h3>
              <p>{v.fit}</p>
              <ul>{v.specs.map((x) => <li>{x}</li>)}</ul>
            </div>
          ))}
        </fieldset>

        <fieldset class="sb__group">
          <legend><span>{c.batLabel}</span> <small>{c.batHint}</small></legend>
          <div class="sb__row">
            <div class="sb__chips">
              {c.batteries.map((b) => (
                <label><input type="radio" name="sb-bat" value={b.key} data-kwh={b.kwh} checked={b.key === 'b16'} /><span>{b.chip}</span></label>
              ))}
            </div>
            <div class="sb__count" role="group" aria-label={c.count}>
              <button type="button" data-step="-1" aria-label={c.less}>−</button>
              <output data-count aria-live="polite">× 1</output>
              <button type="button" data-step="1" aria-label={c.more}>+</button>
            </div>
          </div>
          {c.batteries.map((b) => (
            <div class={`sb__info sb__info--${b.key}`}>
              <h3>{b.name}</h3>
              <p>{b.note}</p>
            </div>
          ))}
        </fieldset>

        <dl class="sb__result" aria-live="polite">
          <div><dt>{c.total}</dt><dd data-total>16 kWh</dd></div>
          <div><dt>{c.essentials}</dt><dd data-ess>{c.hrs.replace('{h}', '24')}</dd></div>
          <div><dt>{c.normal}</dt><dd data-norm>{c.hrs.replace('{h}', '14')}</dd></div>
        </dl>

        <div class="sb__foot">
          <a class="btn btn--primary sb__cta" href={altUrl(locale, 'calculator')} data-track="begin_assessment">{c.cta}</a>
          <p class="sb__fine">{c.fine}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* One screen: compact header, then the product stage and the picker side by side. */
  .sb { background: var(--ff-paper); }
  .sb > .wrap { box-sizing: border-box; height: 100svh; min-height: 560px; display: flex; flex-direction: column; padding: calc(var(--nav-h) + clamp(1rem, 3vh, 2rem)) 0 clamp(1rem, 3vh, 2rem); }
  .sb__head { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1rem 3rem; align-items: end; }
  .sb__head p { justify-self: end; }
  .sb__head h2 { font-size: clamp(1.9rem, 3.4vw, 3rem); }
  .sb__head p { margin: 0; color: var(--ff-slate); font-size: 1.02rem; line-height: 1.5; max-width: 34rem; }
  .sb__grid { flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr); grid-template-rows: minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 4rem);
    align-items: stretch; margin-top: clamp(1rem, 3vh, 2rem); }

  .sb__stage { margin: 0; min-height: 0; display: flex; }
  .sb__floor { position: relative; flex: 1; container-type: size; min-height: 300px; display: flex; align-items: flex-end; justify-content: center;
    gap: 4%; padding: 4% 4% 7%; border-radius: 22px; overflow: hidden;
    background: radial-gradient(ellipse 70% 22% at 50% 90%, rgb(42 45 52 / 0.16), transparent 70%), linear-gradient(#fff, var(--ff-mist)); }
  .sb__invs { display: grid; align-self: flex-start; margin-top: 2cqh; } /* wall-mounted: hangs high, battery stands on the floor */
  .sb__inv { grid-area: 1 / 1; display: none; height: min(74cqh, 60cqw); width: auto; filter: drop-shadow(0 18px 24px rgb(42 45 52 / 0.18)); }
  .sb__inv--k72 { height: min(78cqh, 72cqw); }
  .sb:has(input[value='k72']:checked) .sb__inv--k72,
  .sb:has(input[value='k12']:checked) .sb__inv--k12, .sb:has(input[value='k12p']:checked) .sb__inv--k12p { display: block; animation: sbIn .45s var(--ease); }
  .sb__bats { display: grid; align-items: end; }
  .sb__batset { grid-area: 1 / 1; display: none; align-items: flex-end; }
  .sb:has(input[value='b5']:checked) .sb__batset--b5,
  .sb:has(input[value='b15']:checked) .sb__batset--b15,
  .sb:has(input[value='b16']:checked) .sb__batset--b16 { display: flex; }
  .sb__bat { --k: calc(1 / (1 + (var(--n, 1) - 1) * 0.28)); width: auto; filter: drop-shadow(0 18px 22px rgb(42 45 52 / 0.2)); }
  .sb__bat.is-on + .sb__bat.is-on { margin-left: calc(var(--w) * -0.42); }
  .sb__batset--b5 .sb__bat { --w: 15cqw; height: calc(min(50cqh, 44cqw) * var(--k)); }
  .sb__batset--b15 .sb__bat { --w: 17cqw; height: calc(min(76cqh, 64cqw) * var(--k)); }
  .sb__batset--b16 .sb__bat { --w: 17cqw; height: calc(min(64cqh, 52cqw) * var(--k)); }
  .sb__bat:not(.is-on) { display: none; }

  .sb__panel { display: flex; flex-direction: column; justify-content: center; min-width: 0; }
  .sb__group { border: 0; margin: 0 0 1.1rem; padding: 0; min-width: 0; }
  .sb__group legend { padding: 0; margin-bottom: .5rem; display: flex; align-items: baseline; gap: .6rem; flex-wrap: wrap; }
  .sb__group legend span { font-family: var(--ff-display); font-weight: 700; font-size: 1.3rem; }
  .sb__group legend small { color: var(--ff-slate); font-size: .88rem; }
  .sb__row { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; }
  .sb__chips { display: inline-flex; flex-wrap: wrap; gap: 3px; padding: 3px; border: 1px solid var(--ff-line); border-radius: 999px; background: var(--ff-white); }
  .sb__chips label { position: relative; }
  .sb__chips input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .sb__chips span { display: block; padding: .55rem .95rem; border-radius: 999px; font-weight: 600; font-size: .92rem; color: var(--ff-slate); white-space: nowrap;
    transition: background-color .3s var(--ease), color .3s; }
  .sb__chips input:checked + span { background: var(--ff-ink); color: #fff; }
  .sb__chips input:focus-visible + span { outline: 2px solid var(--ff-green); outline-offset: 2px; }
  .sb__count { display: inline-flex; align-items: center; border: 1px solid var(--ff-line); border-radius: 999px; background: var(--ff-white); padding: 3px; }
  .sb__count button { width: 36px; height: 36px; border: 0; border-radius: 50%; background: transparent; font: 600 1.15rem/1 var(--ff-sans); color: var(--ff-ink); cursor: pointer; }
  .sb__count button:hover:not(:disabled) { background: var(--ff-mist); }
  .sb__count button:disabled { color: #c3c7bd; cursor: default; }
  .sb__count output { min-width: 2.5rem; text-align: center; font-weight: 700; font-variant-numeric: tabular-nums; }

  .sb__info { display: none; margin-top: .6rem; }
  .sb:has(input[value='k72']:checked) .sb__info--k72,
  .sb:has(input[value='k12']:checked) .sb__info--k12, .sb:has(input[value='k12p']:checked) .sb__info--k12p,
  .sb:has(input[value='b5']:checked) .sb__info--b5, .sb:has(input[value='b15']:checked) .sb__info--b15,
  .sb:has(input[value='b16']:checked) .sb__info--b16 { display: block; animation: sbIn .45s var(--ease); }
  @keyframes sbIn { from { opacity: 0; transform: translateY(6px); } }
  .sb__info h3 { margin: 0; font-size: .98rem; display: inline; }
  .sb__info p { margin: 0; color: var(--ff-slate); font-size: .94rem; line-height: 1.45; display: inline; }
  .sb__info h3::after { content: ' · '; color: var(--ff-storm); font-weight: 400; }
  .sb__info ul { margin: .5rem 0 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: .35rem; }
  .sb__info li { font-size: .82rem; font-weight: 500; padding: .3rem .65rem; border-radius: 999px; background: var(--ff-white); border: 1px solid var(--ff-line); }

  .sb__result { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 2rem; margin: .25rem 0 0; padding: .85rem 0;
    border-top: 1px solid var(--ff-line); border-bottom: 1px solid var(--ff-line); }
  .sb__result dt { font-size: .8rem; color: var(--ff-slate); }
  .sb__result dd { margin: .15rem 0 0; font-family: var(--ff-display); font-weight: 700; font-size: clamp(1.6rem, 2.4vw, 2.2rem); line-height: 1; font-variant-numeric: tabular-nums; }
  .sb__foot { display: flex; align-items: center; gap: 1.25rem; margin-top: 1.1rem; }
  .sb__cta { flex: none; }
  .sb__fine { margin: 0; font-size: .76rem; line-height: 1.45; color: var(--ff-slate); }

  /* Short laptop screens: trim the vertical rhythm so everything still fits. */
  @media (min-width: 961px) and (max-height: 820px) {
    .sb > .wrap { padding-top: calc(var(--nav-h) + .75rem); padding-bottom: .75rem; }
    .sb__head h2 { font-size: clamp(1.7rem, 2.8vw, 2.4rem); }
    .sb__head p { font-size: .95rem; }
    .sb__grid { margin-top: .9rem; }
    .sb__group { margin-bottom: .7rem; }
    .sb__group legend { margin-bottom: .35rem; }
    .sb__group legend span { font-size: 1.15rem; }
    .sb__chips span { padding: .45rem .85rem; font-size: .88rem; }
    .sb__count button { width: 32px; height: 32px; }
    .sb__info { margin-top: .4rem; }
    .sb__info ul { margin-top: .35rem; }
    .sb__result { padding: .6rem 0; }
    .sb__result dd { font-size: 1.6rem; }
    .sb__foot { margin-top: .75rem; }
    .sb__cta { min-height: 42px; padding: .6rem 1.1rem; }
  }
  @media (max-width: 960px) {
    .sb > .wrap { height: auto; min-height: 0; padding-top: clamp(4rem, 10vh, 6rem); }
    .sb__head, .sb__grid { grid-template-columns: 1fr; }
    .sb__floor { flex: none; height: 300px; width: 100%; }
    .sb__foot { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 480px) { .sb__result { gap: 1.1rem; } .sb__chips span { padding: .5rem .75rem; font-size: .88rem; } }
</style>

<script>
  // Battery count + runtime estimate. Essentials ≈ 0.6 kW average, normal ≈ 25 kWh/day; 90% usable.
  document.querySelectorAll<HTMLElement>('[data-sb]').forEach((root) => {
    const MAX = 4;
    const tpl = root.dataset.hrs || '~{h} hrs';
    const out = root.querySelector('[data-count]')!;
    const [less, more] = root.querySelectorAll<HTMLButtonElement>('[data-step]');
    let n = 1;
    const fmt = (h: number) => (h > 48 ? tpl.replace('~', '').replace('{h}', '48+') : tpl.replace('{h}', String(Math.max(1, Math.round(h)))));
    function update() {
      const kwh = Number(root.querySelector<HTMLInputElement>('input[name="sb-bat"]:checked')?.dataset.kwh || 16);
      const total = kwh * n;
      out.textContent = `× ${n}`;
      root.style.setProperty('--n', String(n));
      less.disabled = n <= 1; more.disabled = n >= MAX;
      root.querySelector('[data-total]')!.textContent = `${total} kWh`;
      root.querySelector('[data-ess]')!.textContent = fmt((total * 0.9) / 0.6);
      root.querySelector('[data-norm]')!.textContent = fmt((total * 0.9) / (25 / 24));
      root.querySelectorAll<HTMLElement>('.sb__bat').forEach((img) => img.classList.toggle('is-on', Number(img.dataset.n) <= n));
    }
    root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => { n = Math.min(MAX, Math.max(1, n + Number(b.dataset.step))); update(); }));
    root.querySelectorAll('input[name="sb-bat"]').forEach((i) => i.addEventListener('change', update));
    update();
  });
</script>
