---
import { homeCopy } from '../../content/home';
import { altUrl, type Locale } from '../../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = homeCopy[locale].stays;
const hrs = (h: number) => c.hrs.replace('{h}', String(h));
---
<section class="so" id="stays-on" aria-labelledby="so-title">
  <div class="wrap so__grid">
    <div class="so__head">
      <h2 id="so-title" class="display h2" data-rv>{c.title}</h2>
      <p class="lede" data-rv>{c.lede}</p>

      <fieldset class="so__pick" data-rv>
        <legend class="sr">{c.title}</legend>
        {c.tiers.map((tier) => (
          <label>
            <input type="radio" name="so-tier" value={tier.key} checked={tier.key === 'wholehome'} data-on={tier.on} />
            <span>{tier.name}</span>
          </label>
        ))}
      </fieldset>

      {c.tiers.map((tier) => (
        <div class={`so__detail so__detail--${tier.key}`}>
          <p class="so__kit">{tier.kit}</p>
          <p class="so__note">{tier.note}</p>
          <dl class="so__hrs">
            <div><dt>{c.hrsCritLabel}</dt><dd>{hrs(tier.hrsCrit)}</dd></div>
            <div><dt>{c.hrsNormalLabel}</dt><dd>{hrs(tier.hrsNormal)}</dd></div>
          </dl>
        </div>
      ))}

      <a class="btn btn--ink so__cta" href={altUrl(locale, 'calculator')} data-track="begin_assessment">{c.cta}</a>
      <p class="so__fine">{c.fine}</p>
    </div>

    <ul class="so__loads" aria-live="polite">
      {c.loads.map((l, i) => <li style={`--i:${i}`}><i aria-hidden="true"></i>{l}</li>)}
    </ul>
  </div>
</section>

<style>
  .so { background: var(--ff-paper); padding: clamp(6rem, 14vh, 10rem) 0; }
  .so__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(3rem, 7vw, 7rem); align-items: start; }
  .so .lede { color: var(--ff-slate); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .so__pick { display: inline-flex; margin: 2.5rem 0 0; padding: 4px; border: 1px solid var(--ff-line); border-radius: 999px; background: var(--ff-white); }
  .so__pick label { position: relative; }
  .so__pick input { position: absolute; inset: 0; opacity: 0; cursor: pointer; margin: 0; }
  .so__pick span { display: block; padding: .7rem 1.2rem; border-radius: 999px; font-weight: 600; font-size: .98rem; color: var(--ff-slate);
    transition: background-color .3s var(--ease), color .3s; white-space: nowrap; }
  .so__pick input:checked + span { background: var(--ff-ink); color: var(--ff-white); }
  .so__pick input:focus-visible + span { outline: 2px solid var(--ff-green); outline-offset: 2px; }

  .so__detail { display: none; margin-top: 2rem; }
  .so:has(input[value='essentials']:checked) .so__detail--essentials,
  .so:has(input[value='comfort']:checked) .so__detail--comfort,
  .so:has(input[value='wholehome']:checked) .so__detail--wholehome { display: block; animation: soIn .5s var(--ease); }
  @keyframes soIn { from { opacity: 0; transform: translateY(8px); } }
  .so__kit { margin: 0; font-weight: 700; font-size: 1.1rem; }
  .so__note { margin: .35rem 0 0; color: var(--ff-slate); }
  .so__hrs { display: flex; gap: 2.5rem; margin: 1.5rem 0 0; }
  .so__hrs dt { font-size: .85rem; color: var(--ff-slate); }
  .so__hrs dd { margin: .2rem 0 0; font-family: var(--ff-display); font-weight: 700; font-size: clamp(2.2rem, 3.6vw, 3.25rem); line-height: 1; font-variant-numeric: tabular-nums; }
  .so__cta { margin-top: 2.25rem; }
  .so__fine { margin: 1.25rem 0 0; font-size: .85rem; line-height: 1.5; color: var(--ff-slate); max-width: 34rem; }

  .so__loads { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ff-line); }
  .so__loads li { display: flex; align-items: center; gap: 1.1rem; padding: clamp(.85rem, 1.6vw, 1.2rem) 0; border-bottom: 1px solid var(--ff-line);
    font-family: var(--ff-display); font-weight: 700; font-size: clamp(1.6rem, 3vw, 2.6rem); line-height: 1; letter-spacing: -0.015em;
    transition: color .5s var(--ease); transition-delay: calc(var(--i) * 45ms); }
  .so__loads i { flex: none; width: .55em; height: .55em; border-radius: 50%; background: var(--ff-green);
    box-shadow: 0 0 0 4px rgb(158 213 0 / 0.18), 0 0 18px rgb(158 213 0 / 0.65);
    transition: background-color .5s var(--ease), box-shadow .5s var(--ease); transition-delay: inherit; }
  /* Loads beyond the chosen tier go dark. */
  .so:has(input[value='essentials']:checked) .so__loads li:nth-child(n+5),
  .so:has(input[value='comfort']:checked) .so__loads li:nth-child(n+7) { color: #b9bdb3; }
  .so:has(input[value='essentials']:checked) .so__loads li:nth-child(n+5) i,
  .so:has(input[value='comfort']:checked) .so__loads li:nth-child(n+7) i { background: #d6d9cf; box-shadow: none; }

  @media (max-width: 900px) { .so__grid { grid-template-columns: 1fr; } .so__loads { order: 2; } }
  @media (max-width: 420px) { .so__pick span { padding: .65rem .85rem; font-size: .9rem; } }
</style>
