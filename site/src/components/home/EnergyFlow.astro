---
import { homeCopy } from '../../content/home';
import type { Locale } from '../../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = homeCopy[locale].flow;
const n = c.nodes;
// Stage coordinates live in a 1000 x 600 box; nodes use the same numbers as the SVG paths.
const nodes = [
  { key: 'solar', x: 150, y: 120, img: '/assets/diagram/solar.webp' },
  { key: 'grid', x: 860, y: 125, img: '/assets/diagram/grid.webp' },
  { key: 'inverter', x: 500, y: 380, img: '/assets/equipment/lineup/k12.webp' },
  { key: 'battery', x: 155, y: 470, img: '/assets/equipment/lineup/b16.webp' },
  { key: 'home', x: 845, y: 480, img: '/assets/diagram/home.webp' },
] as const;
// Drawn source → inverter → load. Battery is drawn inverter → battery (forward = charging); grid is drawn grid → inverter (reverse = export).
const paths = {
  solar: 'M 260 140 C 300 140, 360 380, 445 380',
  grid: 'M 815 145 C 740 145, 640 380, 555 380',
  battery: 'M 445 410 C 360 410, 320 470, 225 470',
  home: 'M 555 410 C 650 410, 690 480, 745 480',
};
---
<section class="ef" id="how" aria-labelledby="ef-title" data-ef data-mode="outage">
  <div class="wrap ef__in">
    <header class="ef__head">
      <div>
        <h2 id="ef-title" class="display">{c.title}</h2>
        <p>{c.lede}</p>
      </div>
      <ol class="ef__steps">
        {c.modes.map((m, i) => (
          <li><button type="button" data-mode-btn={m.key} aria-pressed={i === 0 ? 'true' : 'false'}><b>{i + 1}</b>{m.name}</button></li>
        ))}
      </ol>
    </header>

    <div class="ef__canvas">
        <div class="ef__say" aria-live="polite">
        {c.modes.map((m, i) => (
          <div data-mode-text={m.key} hidden={i !== 0}>
            <span class="ef__num">{i + 1} / {c.modes.length}</span>
            <p class="ef__h">{m.h}</p>
            <p class="ef__p">{m.p}</p>
          </div>
        ))}
      </div>

    <div class="ef__stage">
      <svg viewBox="0 0 1000 600" aria-hidden="true">
        {Object.values(paths).map((d) => <path class="ef__rail" d={d} />)}
        {Object.entries(paths).map(([k, d]) => <path class={`ef__flow ef__flow--${k}`} d={d} />)}
      </svg>

      {nodes.map((nd) => (
        <figure class={`ef__node ef__node--${nd.key}`} style={`--x:${nd.x / 10}%;--y:${nd.y / 6}%`}>
          <img src={nd.img} alt="" loading="lazy" decoding="async" />
          <figcaption><span>{n[nd.key][0]}{nd.key === 'grid' && <em>{c.offline}</em>}</span><small>{n[nd.key][1]}</small></figcaption>
        </figure>
      ))}
    </div>
    </div>
  </div>

</section>

<style>
  .ef { position: relative; color: var(--on-night); overflow: hidden;
    background: radial-gradient(ellipse 70% 60% at 50% 55%, #161a12, var(--night) 70%); padding-bottom: clamp(1rem, 3vh, 2rem); }
  /* The header, stages and diagram share one screen. */
  .ef__in { box-sizing: border-box; min-height: 100svh; display: flex; flex-direction: column; padding-top: calc(var(--nav-h) + clamp(1rem, 3vh, 2rem)); padding-bottom: 1rem; }
  .ef__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1rem 2rem; }
  .ef__head h2 { font-size: clamp(1.9rem, 3.4vw, 3rem); }
  .ef__head p { margin: .5rem 0 0; color: var(--on-night-2); }
  .ef__steps { list-style: none; margin: 0; padding: 4px; display: flex; flex-wrap: wrap; gap: 4px; border-radius: 999px;
    background: rgb(255 255 255 / 0.05); border: 1px solid var(--night-line); }
  .ef__steps button { display: inline-flex; align-items: center; gap: .5rem; border: 0; border-radius: 999px; padding: .55rem 1rem .55rem .55rem;
    background: transparent; color: var(--on-night-2); font: 600 .92rem/1 var(--ff-sans); cursor: pointer; transition: background-color .3s var(--ease), color .3s; }
  .ef__steps b { display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: rgb(255 255 255 / 0.08); font-size: .8rem; }
  .ef__steps button:hover { color: var(--on-night); }
  .ef__steps button[aria-pressed='true'] { background: var(--ff-green); color: var(--ff-ink); }
  .ef__steps button[aria-pressed='true'] b { background: var(--ff-ink); color: var(--ff-green); }
  .ef__steps button { position: relative; overflow: hidden; }
  .ef__steps button::after { content: ''; position: absolute; left: 0; bottom: 0; height: 3px; width: 100%; background: rgb(42 45 52 / .45); transform: scaleX(0); transform-origin: left; }
  .is-timing .ef__steps button[aria-pressed='true']::after { animation: efTime 8s linear forwards; }
  @keyframes efTime { to { transform: scaleX(1); } }

  .ef__stage { position: relative; container-type: size; aspect-ratio: 1000 / 600; width: auto; max-width: 100%;
    height: min(calc(100svh - var(--nav-h) - 10.5rem), calc((min(100vw, var(--wide)) - 2 * var(--gutter)) * 0.6));
    margin: clamp(.75rem, 2vh, 1.5rem) auto 0; }
  .ef__stage svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .ef__rail { fill: none; stroke: rgb(255 255 255 / 0.1); stroke-width: 3; stroke-linecap: round; }
  .ef__flow { fill: none; stroke-width: 4.5; stroke-linecap: round; stroke-dasharray: 2 16; opacity: 0;
    transition: opacity .9s var(--ease); animation: efFlow 1.1s linear infinite; }
  @keyframes efFlow { to { stroke-dashoffset: -18; } }
  .ef__flow--solar { stroke: var(--ff-gold); filter: drop-shadow(0 0 6px rgb(255 184 28 / .8)); }
  .ef__flow--grid { stroke: var(--amber); filter: drop-shadow(0 0 6px rgb(255 176 74 / .8)); }
  .ef__flow--battery, .ef__flow--home { stroke: var(--ff-green); filter: drop-shadow(0 0 7px rgb(158 213 0 / .8)); }

  /* Stage → which lines carry power. */
  [data-mode='outage'] :is(.ef__flow--battery, .ef__flow--home),
  [data-mode='solar'] :is(.ef__flow--solar, .ef__flow--battery, .ef__flow--home),
  [data-mode='battery'] :is(.ef__flow--battery, .ef__flow--home),
  [data-mode='export'] :is(.ef__flow--solar, .ef__flow--grid, .ef__flow--home) { opacity: 1; }
  :is([data-mode='outage'], [data-mode='battery']) .ef__flow--battery { animation-direction: reverse; }
  [data-mode='solar'] .ef__flow--battery { stroke: var(--ff-gold); filter: drop-shadow(0 0 6px rgb(255 184 28 / .8)); }
  [data-mode='export'] .ef__flow--grid { animation-direction: reverse; stroke: var(--ff-gold); filter: drop-shadow(0 0 6px rgb(255 184 28 / .8)); }

  .ef__node { position: absolute; left: var(--x); top: var(--y); margin: 0; transform: translate(-50%, -50%);
    display: grid; justify-items: center; gap: .4rem; transition: opacity .9s var(--ease), filter .9s var(--ease); }
  .ef__node img { width: auto; filter: drop-shadow(0 18px 24px rgb(0 0 0 / .5)); }
  .ef__node--solar img { width: 21cqw; }
  .ef__node--grid img { height: 28cqh; }
  .ef__node--inverter img { height: 40cqh; }
  .ef__node--battery img { height: 32cqh; }
  .ef__node--home img { width: 23cqw; }
  .ef__node--inverter::before { content: ''; position: absolute; inset: -18% -40%; z-index: -1; border-radius: 50%;
    background: radial-gradient(closest-side, rgb(158 213 0 / 0.22), transparent); }
  .ef__node figcaption { display: grid; justify-items: center; gap: .15rem; text-align: center; white-space: nowrap; }
  .ef__node figcaption span { font-size: clamp(.72rem, 1.6cqw, .92rem); font-weight: 600; display: inline-flex; gap: .45rem; align-items: center; }
  .ef__node figcaption small { font-size: clamp(.64rem, 1.35cqw, .8rem); color: var(--on-night-2); }
  .ef__node figcaption em { display: none; font-style: normal; font-size: .72rem; padding: .15rem .45rem; border-radius: 999px; background: #3a3e46; color: var(--on-night-2); }
  :is([data-mode='outage'], [data-mode='solar'], [data-mode='battery']) .ef__node--grid { opacity: .3; filter: grayscale(1); }
  :is([data-mode='outage'], [data-mode='solar'], [data-mode='battery']) .ef__node--grid figcaption em { display: inline-block; }
  :is([data-mode='outage'], [data-mode='battery']) .ef__node--solar { opacity: .4; filter: grayscale(.6); }

  /* The stage statement sits in the open space between the panels and the pole. */
  .ef__canvas { position: relative; }
  .ef__say { position: absolute; z-index: 2; left: 50%; top: clamp(.75rem, 2vh, 1.5rem); width: min(36%, 28rem); transform: translateX(-50%); text-align: center; pointer-events: none; }
  .ef__say > div { animation: efSay .8s var(--ease); }
  @keyframes efSay { from { opacity: 0; transform: translateY(10px); } }
  .ef__num { display: inline-block; font-size: .78rem; font-weight: 700; letter-spacing: .12em; color: var(--ff-green); }
  .ef__h { margin: .35rem 0 0; font-family: var(--ff-display); font-weight: 700; font-size: clamp(1.4rem, 2.6vw, 2.5rem); line-height: 1; letter-spacing: -0.015em; text-wrap: balance; }
  .ef__p { margin: .6rem auto 0; max-width: 34ch; font-size: clamp(.82rem, 1vw, 1rem); line-height: 1.45; color: var(--on-night-2); }

  @media (max-width: 900px) {
    .ef__in { min-height: 0; }
    .ef__stage { width: 100%; height: auto; }
  }
  @media (max-width: 600px) {
    /* Phones: the statement moves above the diagram so both stay readable. */
    .ef__say { position: static; transform: none; width: auto; text-align: left; min-height: 8.5rem; margin-top: 1.25rem; pointer-events: auto; }
    .ef__h { font-size: 1.6rem; } .ef__p { font-size: .95rem; }
    .ef__p { margin-left: 0; }
    .ef__stage { margin-top: .5rem; }
    .ef__node figcaption small { display: none; }
    .ef__node figcaption span { font-size: .62rem; }
  }
  @media (prefers-reduced-motion: reduce) { .ef__flow { animation: none; stroke-dasharray: none; } .ef__say > div { animation: none; } }
</style>

<script>
  // Step through the four stages while the diagram is on screen; a click takes over.
  document.querySelectorAll<HTMLElement>('[data-ef]').forEach((root) => {
    const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-mode-btn]')];
    const keys = btns.map((b) => b.dataset.modeBtn!);
    const STEP_MS = 8000;
    let i = 0, timer = 0, manual = false;
    const set = (k: string) => {
      root.dataset.mode = k;
      root.classList.remove('is-timing'); void root.offsetWidth; if (!manual) root.classList.add('is-timing');
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.modeBtn === k)));
      root.querySelectorAll<HTMLElement>('[data-mode-text]').forEach((t) => (t.hidden = t.dataset.modeText !== k));
    };
    btns.forEach((b) => b.addEventListener('click', () => { manual = true; root.classList.remove('is-timing'); clearInterval(timer); i = keys.indexOf(b.dataset.modeBtn!); set(keys[i]); }));
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    new IntersectionObserver(([e]) => {
      clearInterval(timer);
      if (e.isIntersecting && !manual) { root.classList.add('is-timing'); } else root.classList.remove('is-timing');
      if (e.isIntersecting && !manual) timer = window.setInterval(() => { i = (i + 1) % keys.length; set(keys[i]); }, STEP_MS);
    }, { threshold: 0.4 }).observe(root);
  });
</script>
