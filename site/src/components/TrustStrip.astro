---
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const stats = [
  { num: t(locale, 'trust.stat1_num'), label: t(locale, 'trust.stat1_label') },
  { num: t(locale, 'trust.stat2_num'), label: t(locale, 'trust.stat2_label') },
  { num: t(locale, 'trust.stat3_num'), label: t(locale, 'trust.stat3_label') },
  { num: t(locale, 'trust.stat4_num'), label: t(locale, 'trust.stat4_label') },
];
---
<section class="ff-trust">
  <ul class="ff-trust__row">
    {stats.map((s) => (
      <li class="ff-trust__stat">
        <span class="stat-num" data-countup>{s.num}</span>
        <span class="ff-trust__label">{s.label}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .ff-trust {
    background: var(--ff-mist);
    border-block: 1px solid var(--ff-line);
    padding: var(--sp-4) var(--sp-3);
  }
  .ff-trust__row {
    max-width: var(--container);
    margin: 0 auto;
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-3);
    text-align: center;
  }
  /* min-width:0 lets grid items shrink to their 1fr column instead of being
     forced wider by their content (which caused a mobile horizontal-scroll). */
  .ff-trust__stat { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  .stat-num {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    font-weight: 700;
    color: var(--ff-ink);
    overflow-wrap: anywhere;
  }
  .ff-trust__label {
    font-size: var(--fs-small);
    color: var(--ff-slate);
    font-weight: 600;
  }
  @media (max-width: 720px) {
    .ff-trust__row { grid-template-columns: repeat(2, 1fr); gap: var(--sp-4) var(--sp-3); }
  }
</style>
