---
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  /** CRM base URL; falls back to PUBLIC_SUPABASE_URL or '' (→ placeholder pricing / WhatsApp). */
  baseUrl?: string;
}
const { locale, baseUrl } = Astro.props;
const resolvedBase = baseUrl ?? import.meta.env.PUBLIC_SUPABASE_URL ?? '';

// WhatsApp deep link for the soft-net / error fallback.
const waNumber = t(locale, 'common.whatsapp');
const waHref = `https://wa.me/${waNumber}`;
const emailAddr = t(locale, 'common.email');

// Step 1 choices → home value.
const homeChoices = [
  { value: 'cozy', title: 'estimator.home_cozy', note: 'estimator.home_cozy_note' },
  { value: 'family', title: 'estimator.home_family', note: 'estimator.home_family_note' },
  { value: 'estate', title: 'estimator.home_estate', note: 'estimator.home_estate_note' },
  { value: 'business', title: 'estimator.home_business', note: 'estimator.home_business_note' },
];
// Step 2 choices → backup value.
const backupChoices = [
  { value: 'essentials', title: 'estimator.backup_essentials', note: 'estimator.backup_essentials_note' },
  { value: 'usual', title: 'estimator.backup_usual', note: 'estimator.backup_usual_note' },
  { value: 'everything', title: 'estimator.backup_everything', note: 'estimator.backup_everything_note' },
];
// Step 3 choices → solar value.
const solarChoices = [
  { value: 'have', title: 'estimator.solar_have', note: 'estimator.solar_have_note' },
  { value: 'add', title: 'estimator.solar_add', note: 'estimator.solar_add_note' },
  { value: 'none', title: 'estimator.solar_none', note: 'estimator.solar_none_note' },
];

const steps = [
  { key: 'home', legend: 'estimator.step1_legend', choices: homeChoices },
  { key: 'backup', legend: 'estimator.step2_legend', choices: backupChoices },
  { key: 'solar', legend: 'estimator.step3_legend', choices: solarChoices },
];
---
<section
  id="estimator"
  class="ff-est"
  aria-labelledby="ff-est-title"
  data-estimator
  data-base-url={resolvedBase}
  data-wa-href={waHref}
>
  <div class="ff-est__inner">
    <header class="ff-est__head">
      <p class="ff-est__eyebrow">{t(locale, 'estimator.eyebrow')}</p>
      <h2 id="ff-est-title" class="ff-est__title display">{t(locale, 'estimator.title')}</h2>
      <p class="ff-est__sub">{t(locale, 'estimator.sub')}</p>
    </header>

    <div class="ff-est__card">
      <!-- Progress dots (steps 1..4) -->
      <ol class="ff-est__progress" data-progress aria-label={t(locale, 'estimator.progress_label').replace('{step}', '1').replace('{total}', '4')}>
        {[1, 2, 3, 4].map((n) => (
          <li class={`ff-est__dot${n === 1 ? ' is-active' : ''}`} data-dot={n} aria-hidden="true"></li>
        ))}
      </ol>

      <!-- Steps 1-3: radio-group choice fieldsets -->
      {steps.map((s, i) => (
        <fieldset class={`ff-est__step${i === 0 ? ' is-current' : ''}`} data-step={i + 1} hidden={i !== 0}>
          <legend class="ff-est__legend">{t(locale, s.legend)}</legend>
          <div class="ff-est__choices" role="radiogroup" aria-label={t(locale, s.legend)}>
            {s.choices.map((c) => (
              <button
                type="button"
                class="ff-est__choice"
                role="radio"
                aria-checked="false"
                data-answer-key={s.key}
                data-answer-value={c.value}
              >
                <span class="ff-est__choice-title">{t(locale, c.title)}</span>
                <span class="ff-est__choice-note">{t(locale, c.note)}</span>
              </button>
            ))}
          </div>
        </fieldset>
      ))}

      <!-- Step 4: RESULTS FIRST (three tiers), then capture -->
      <div class="ff-est__step ff-est__results" data-step="4" hidden>
        <div class="ff-est__result-block">
          <p class="ff-est__result-intro">{t(locale, 'estimator.result_intro')}</p>
          <div class="ff-est__result-head">
            <h3 class="ff-est__result-title">{t(locale, 'estimator.tiers_heading')}</h3>
            <div class="ff-est__currency" role="radiogroup" aria-label={t(locale, 'estimator.currency_aria')}>
              <button type="button" class="ff-est__cur is-active" role="radio" aria-checked="true" data-currency="USD">{t(locale, 'estimator.currency_usd')}</button>
              <button type="button" class="ff-est__cur" role="radio" aria-checked="false" data-currency="MXN">{t(locale, 'estimator.currency_mxn')}</button>
            </div>
          </div>

          <!-- Three priced tiers, populated by the script (data-driven). -->
          <ul class="ff-est__tiers" data-tiers role="radiogroup" aria-label={t(locale, 'estimator.tiers_heading')} aria-live="polite">
            {['essentials', 'critical', 'recommended'].map((key) => (
              <li class="ff-est__tier" data-tier={key}>
                <button type="button" class="ff-est__tier-btn" role="radio" aria-checked="false" data-tier-select={key}>
                  <span class="ff-est__tier-badge" data-tier-badge hidden>{t(locale, 'estimator.tier_badge')}</span>
                  <span class="ff-est__tier-name" data-tier-name></span>
                  <span class="ff-est__tier-cover" data-tier-cover></span>
                  <span class="ff-est__tier-chips" data-tier-chips></span>
                  <span class="ff-est__tier-price">
                    <span class="ff-est__tier-from">{t(locale, 'estimator.price_from')}</span>
                    <span class="ff-est__tier-amount" data-tier-amount></span>
                    <span class="ff-est__tier-iva" data-tier-iva></span>
                  </span>
                  <span class="ff-est__tier-cta" data-tier-cta>{t(locale, 'estimator.tier_select')}</span>
                </button>
              </li>
            ))}
          </ul>

          <p class="ff-est__qualifier" data-qualifier>{t(locale, 'estimator.qualifier')}</p>
        </div>

        <!-- Capture form sits BELOW the result -->
        <form class="ff-est__capture" data-capture novalidate>
          <h3 class="ff-est__capture-title">{t(locale, 'estimator.capture_title')}</h3>
          <p class="ff-est__capture-sub">{t(locale, 'estimator.capture_sub')}</p>

          <label class="ff-est__field">
            <span class="ff-est__field-label">{t(locale, 'estimator.name_label')}</span>
            <input type="text" name="name" autocomplete="name" required
              placeholder={t(locale, 'estimator.name_placeholder')} data-name />
          </label>

          <label class="ff-est__field">
            <span class="ff-est__field-label">{t(locale, 'estimator.contact_label')}</span>
            <input type="text" name="contact" autocomplete="off" required
              placeholder={t(locale, 'estimator.contact_placeholder')} data-contact />
          </label>

          <!-- Honeypot: visually hidden, off the tab order, ignored by humans. -->
          <div class="ff-est__hp" aria-hidden="true">
            <label>{t(locale, 'estimator.company_label')}
              <input type="text" name="company_url" tabindex="-1" autocomplete="off" data-hp />
            </label>
          </div>

          <button type="submit" class="ff-est__submit" data-submit disabled>{t(locale, 'estimator.submit')}</button>

          <div class="ff-est__softnets">
            <a class="ff-est__soft" href={`mailto:${emailAddr}`} data-soft-email>{t(locale, 'estimator.soft_email')}</a>
            <a class="ff-est__soft" href={waHref} target="_blank" rel="noopener" data-soft-wa>{t(locale, 'estimator.soft_whatsapp')}</a>
          </div>
        </form>

        <!-- Thank-you / error states (toggled by script) -->
        <div class="ff-est__state ff-est__state--ok" data-state-ok hidden role="status">
          <h3 class="ff-est__state-title">{t(locale, 'estimator.thanks_title')}</h3>
          <p>{t(locale, 'estimator.thanks_body')}</p>
        </div>
        <div class="ff-est__state ff-est__state--err" data-state-err hidden role="alert">
          <h3 class="ff-est__state-title">{t(locale, 'estimator.error_title')}</h3>
          <p>{t(locale, 'estimator.error_body')}</p>
          <a class="ff-est__wa-btn" href={waHref} target="_blank" rel="noopener">{t(locale, 'common.whatsapp_label')}</a>
        </div>
      </div>

      <!-- Step navigation (hidden on results until restart) -->
      <div class="ff-est__nav" data-nav>
        <button type="button" class="ff-est__back" data-back hidden>{t(locale, 'estimator.back')}</button>
        <button type="button" class="ff-est__restart" data-restart hidden>{t(locale, 'estimator.restart')}</button>
      </div>

      <p class="ff-est__disclaimer">{t(locale, 'estimator.disclaimer')}</p>
    </div>
  </div>
</section>

<style>
  .ff-est { background: var(--ff-green-tint); padding: var(--sp-7) var(--sp-3); }
  .ff-est__inner { max-width: var(--container-tight); margin: 0 auto; }
  .ff-est__head { text-align: center; margin-bottom: var(--sp-4); }
  .ff-est__eyebrow {
    text-transform: uppercase; letter-spacing: 0.12em; font-size: var(--fs-eyebrow);
    font-weight: 700; color: var(--ff-accent-dk); margin: 0 0 var(--sp-2);
  }
  .ff-est__title { font-size: var(--fs-h1); line-height: var(--lh-snug); margin: 0 0 var(--sp-2); }
  .ff-est__sub { font-size: var(--fs-lead); color: var(--ff-slate); margin: 0; }

  .ff-est__card {
    background: var(--ff-white); border: 1px solid var(--ff-line);
    border-radius: var(--r-lg); box-shadow: var(--shadow-md);
    padding: var(--sp-5) var(--sp-4);
  }

  /* ---- Progress dots ---- */
  .ff-est__progress { list-style: none; display: flex; gap: var(--sp-1); justify-content: center; margin: 0 0 var(--sp-4); padding: 0; }
  .ff-est__dot { width: 10px; height: 10px; border-radius: var(--r-pill); background: var(--ff-mist); transition: background var(--dur) var(--ease), width var(--dur) var(--ease); }
  .ff-est__dot.is-active { background: var(--ff-accent); width: 26px; }
  .ff-est__dot.is-done { background: var(--ff-green); }

  /* ---- Step / choices ---- */
  .ff-est__step { border: 0; margin: 0; padding: 0; }
  .ff-est__legend { font-size: var(--fs-h3); font-weight: 700; color: var(--ff-ink); text-align: center; width: 100%; margin: 0 auto var(--sp-3); padding: 0; }
  .ff-est__choices { display: grid; gap: var(--sp-2); }
  @media (min-width: 560px) { .ff-est__choices { grid-template-columns: 1fr 1fr; } }

  .ff-est__choice {
    display: flex; flex-direction: column; gap: 0.2rem; text-align: left;
    background: var(--ff-paper); border: 2px solid var(--ff-line);
    border-radius: var(--r-md); padding: var(--sp-3); cursor: pointer;
    transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease), transform var(--dur) var(--ease);
    font-family: var(--ff-sans);
  }
  .ff-est__choice:hover { border-color: var(--ff-green); transform: translateY(-2px); }
  .ff-est__choice:focus-visible { outline: 3px solid var(--ff-accent); outline-offset: 2px; }
  .ff-est__choice[aria-checked='true'] { border-color: var(--ff-accent); background: var(--ff-accent-tint); }
  .ff-est__choice-title { font-weight: 700; color: var(--ff-ink); font-size: var(--fs-body); }
  .ff-est__choice-note { color: var(--ff-slate); font-size: var(--fs-small); }

  /* ---- Results ---- */
  .ff-est__result-intro { color: var(--ff-slate); margin: 0 0 0.25rem; font-size: var(--fs-small); }
  .ff-est__result-head { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-2); flex-wrap: wrap; margin: 0 0 var(--sp-3); }
  .ff-est__result-title { font-size: var(--fs-h3); margin: 0; color: var(--ff-ink); }

  .ff-est__currency { display: inline-flex; border: 1px solid var(--ff-line); border-radius: var(--r-pill); overflow: hidden; }
  .ff-est__cur { background: var(--ff-white); border: 0; padding: 0.35rem 0.9rem; font-weight: 700; font-size: var(--fs-small); color: var(--ff-slate); cursor: pointer; font-family: var(--ff-sans); }
  .ff-est__cur.is-active { background: var(--ff-ink); color: var(--ff-white); }
  .ff-est__cur:focus-visible { outline: 3px solid var(--ff-accent); outline-offset: -3px; }

  /* ---- Tier cards ---- */
  .ff-est__tiers { list-style: none; display: grid; gap: var(--sp-2); padding: 0; margin: 0 0 var(--sp-3); }
  @media (min-width: 720px) { .ff-est__tiers { grid-template-columns: repeat(3, 1fr); align-items: stretch; } }
  .ff-est__tier { display: flex; }
  .ff-est__tier-btn {
    position: relative; display: flex; flex-direction: column; gap: 0.35rem; width: 100%;
    text-align: left; background: var(--ff-paper); border: 2px solid var(--ff-line);
    border-radius: var(--r-md); padding: var(--sp-3); cursor: pointer; font-family: var(--ff-sans);
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .ff-est__tier-btn:hover { transform: translateY(-2px); border-color: var(--ff-green); }
  .ff-est__tier-btn:focus-visible { outline: 3px solid var(--ff-accent); outline-offset: 2px; }
  .ff-est__tier.is-highlight .ff-est__tier-btn { border-color: var(--ff-accent); box-shadow: var(--shadow-md); }
  .ff-est__tier-btn[aria-checked='true'] { border-color: var(--ff-accent); background: var(--ff-accent-tint); }
  .ff-est__tier-badge {
    position: absolute; top: -0.7rem; right: var(--sp-3); background: var(--ff-accent); color: var(--ff-white);
    font-size: var(--fs-eyebrow); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    padding: 0.2rem 0.6rem; border-radius: var(--r-pill);
  }
  .ff-est__tier-name { font-weight: 700; font-size: var(--fs-body); color: var(--ff-ink); }
  .ff-est__tier-cover { color: var(--ff-slate); font-size: var(--fs-small); }
  .ff-est__tier-chips { color: var(--ff-ink); font-size: var(--fs-small); font-weight: 700; }
  .ff-est__tier-price { margin-top: auto; padding-top: var(--sp-2); display: flex; flex-direction: column; }
  .ff-est__tier-from { color: var(--ff-storm); font-size: var(--fs-eyebrow); text-transform: uppercase; letter-spacing: 0.08em; }
  .ff-est__tier-amount { font-family: var(--ff-display); font-size: var(--fs-h3); color: var(--ff-accent-dk); line-height: var(--lh-snug); }
  .ff-est__tier-iva { color: var(--ff-slate); font-size: var(--fs-small); }
  .ff-est__tier-cta {
    margin-top: var(--sp-2); display: inline-block; text-align: center; background: var(--ff-ink); color: var(--ff-white);
    font-weight: 700; font-size: var(--fs-small); padding: 0.5rem 1rem; border-radius: var(--r-pill);
  }
  .ff-est__tier-btn[aria-checked='true'] .ff-est__tier-cta { background: var(--ff-accent); }
  .ff-est__qualifier { color: var(--ff-storm); font-size: var(--fs-small); margin: 0 0 var(--sp-4); }

  /* ---- Capture ---- */
  .ff-est__capture-title { font-size: var(--fs-h3); margin: 0 0 0.25rem; color: var(--ff-ink); }
  .ff-est__capture-sub { color: var(--ff-slate); font-size: var(--fs-small); margin: 0 0 var(--sp-3); }
  .ff-est__field { display: block; margin-bottom: var(--sp-2); }
  .ff-est__field-label { display: block; font-weight: 700; font-size: var(--fs-small); color: var(--ff-ink); margin-bottom: 0.3rem; }
  .ff-est__field input {
    width: 100%; box-sizing: border-box; padding: 0.7rem 0.9rem;
    border: 2px solid var(--ff-line); border-radius: var(--r-md);
    font-family: var(--ff-sans); font-size: var(--fs-body); background: var(--ff-paper);
  }
  .ff-est__field input:focus-visible { outline: 3px solid var(--ff-accent); outline-offset: 1px; border-color: var(--ff-accent); }

  /* Honeypot — hidden from people, present for bots. */
  .ff-est__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .ff-est__submit, .ff-est__wa-btn {
    display: inline-block; width: 100%; box-sizing: border-box; text-align: center;
    background: var(--ff-accent); color: var(--ff-white); border: 0;
    font-weight: 700; font-size: var(--fs-body); padding: 0.85rem 1.5rem;
    border-radius: var(--r-pill); cursor: pointer; margin-top: var(--sp-2);
    font-family: var(--ff-sans); text-decoration: none;
    transition: background var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .ff-est__submit:hover:not(:disabled), .ff-est__wa-btn:hover { background: var(--ff-accent-dk); transform: translateY(-2px); }
  .ff-est__submit:disabled { background: var(--ff-storm); cursor: not-allowed; }
  .ff-est__submit:focus-visible, .ff-est__wa-btn:focus-visible { outline: 3px solid var(--ff-ink); outline-offset: 2px; }

  .ff-est__softnets { display: flex; flex-direction: column; gap: 0.4rem; margin-top: var(--sp-3); text-align: center; }
  .ff-est__soft { color: var(--ff-slate); font-size: var(--fs-small); text-decoration: underline; }
  .ff-est__soft:hover { color: var(--ff-accent-dk); }

  .ff-est__state { text-align: center; padding: var(--sp-3) 0; }
  .ff-est__state-title { font-size: var(--fs-h3); margin: 0 0 0.5rem; color: var(--ff-ink); }
  .ff-est__state--err .ff-est__state-title { color: var(--ff-accent-dk); }
  .ff-est__wa-btn { max-width: 320px; margin: var(--sp-2) auto 0; }

  /* ---- Nav / disclaimer ---- */
  .ff-est__nav { display: flex; justify-content: space-between; margin-top: var(--sp-4); }
  .ff-est__back, .ff-est__restart {
    background: transparent; border: 2px solid var(--ff-line); color: var(--ff-ink);
    font-weight: 700; padding: 0.55rem 1.2rem; border-radius: var(--r-pill);
    cursor: pointer; font-family: var(--ff-sans);
  }
  .ff-est__back:hover, .ff-est__restart:hover { border-color: var(--ff-ink); }
  .ff-est__back:focus-visible, .ff-est__restart:focus-visible { outline: 3px solid var(--ff-accent); outline-offset: 2px; }
  .ff-est__disclaimer { text-align: center; color: var(--ff-storm); font-size: var(--fs-small); margin: var(--sp-4) 0 0; }

  @media (max-width: 560px) {
    .ff-est__card { padding: var(--sp-4) var(--sp-3); }
  }
</style>

<script>
  import { createEstimator } from './Estimator.client';
  import { fetchPricing } from '../lib/pricingClient';
  import { submitLead, type LeadPayload } from '../lib/leadClient';
  import { t, type Locale } from '../lib/i18n';
  import { PRICING } from '../lib/pricing.config';
  import type { Tier } from '../lib/tiers';

  // Display FX rate (USD → MXN). Sourced from the pricing snapshot today; this
  // will later come from a CRM daily-rate endpoint (Phase 6b).
  const MXN_PER_USD = PRICING.fxUsdMxn;

  const root = document.querySelector<HTMLElement>('[data-estimator]');
  if (root) {
    initEstimator(root);
  }

  function initEstimator(root: HTMLElement) {
    const baseUrl = root.dataset.baseUrl ?? '';
    const TOTAL = 4;

    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-dot]'));
    const stepEls = Array.from(root.querySelectorAll<HTMLElement>('[data-step]'));
    const backBtn = root.querySelector<HTMLButtonElement>('[data-back]');
    const restartBtn = root.querySelector<HTMLButtonElement>('[data-restart]');
    const choices = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-answer-key]'));

    const tierEls = Array.from(root.querySelectorAll<HTMLElement>('[data-tier]'));
    const curBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-currency]'));

    const form = root.querySelector<HTMLFormElement>('[data-capture]');
    const nameInput = root.querySelector<HTMLInputElement>('[data-name]');
    const contactInput = root.querySelector<HTMLInputElement>('[data-contact]');
    const hpInput = root.querySelector<HTMLInputElement>('[data-hp]');
    const submitBtn = root.querySelector<HTMLButtonElement>('[data-submit]');
    const okState = root.querySelector<HTMLElement>('[data-state-ok]');
    const errState = root.querySelector<HTMLElement>('[data-state-err]');

    const locale: Locale = document.documentElement.lang === 'es' ? 'es' : 'en';
    const tr = (k: string) => t(locale, k);
    const panelsLabel = (n: number) =>
      n > 0 ? (locale === 'es' ? `${n} paneles` : `${n} panels`) : '';
    // One-line config summary chips per tier, e.g. "6.5 kW · 5 kWh + Essential Loads Panel".
    function tierChips(cfg: Tier['config']): string {
      const parts = [`${cfg.inverterKw} kW`, `${cfg.batteryKwh} kWh`];
      if (cfg.panels > 0) parts.push(panelsLabel(cfg.panels));
      let s = parts.join(' · ');
      if (cfg.includeSubpanel) s += ` + ${tr('estimator.tier_subpanel_chip')}`;
      return s;
    }
    const TIER_NAME: Record<Tier['key'], string> = {
      essentials: 'estimator.tier_essentials_name',
      critical: 'estimator.tier_critical_name',
      recommended: 'estimator.tier_recommended_name',
    };
    const TIER_COVER: Record<Tier['key'], string> = {
      essentials: 'estimator.tier_essentials_cover',
      critical: 'estimator.tier_critical_cover',
      recommended: 'estimator.tier_recommended_cover',
    };

    let currency: 'USD' | 'MXN' = 'USD';
    let selectedTier: Tier['key'] | null = null;
    // Mirror answers locally so a rebuilt store can be re-synced.
    const answers: Record<string, string> = {};
    let uiStep = 1;

    // Estimator store: pricing resolved async; rebuild deps once it arrives.
    let store = createEstimator({
      pricing: null,
      leadClient: (p: LeadPayload) => submitLead(baseUrl, p),
    });

    fetchPricing(baseUrl)
      .then((pricing) => {
        store = createEstimator({
          pricing,
          leadClient: (p: LeadPayload) => submitLead(baseUrl, p),
        });
        // Re-apply any answers already chosen so the new store stays in sync.
        for (const [k, v] of Object.entries(answers)) {
          store.setAnswer(k as 'home' | 'backup' | 'solar', v as never);
        }
        if (store.step !== uiStep) {
          while (store.step < uiStep) store.next();
          while (store.step > uiStep) store.back();
        }
        if (uiStep === TOTAL && store.isComplete()) renderResult();
      })
      .catch(() => {
        /* keep placeholder pricing */
      });

    function showStep(n: number) {
      uiStep = n;
      for (const el of stepEls) {
        el.hidden = Number(el.dataset.step) !== n;
      }
      dots.forEach((d, i) => {
        const idx = i + 1;
        d.classList.toggle('is-active', idx === n);
        d.classList.toggle('is-done', idx < n);
      });
      if (backBtn) backBtn.hidden = n === 1 || n === TOTAL;
      if (restartBtn) restartBtn.hidden = n !== TOTAL;
      // Move focus to the step legend / heading for screen-reader continuity.
      const cur = stepEls.find((el) => Number(el.dataset.step) === n);
      const heading = cur?.querySelector<HTMLElement>('legend, .ff-est__result-title');
      heading?.setAttribute('tabindex', '-1');
      heading?.focus({ preventScroll: false });
      if (n === TOTAL && store.isComplete()) renderResult();
    }

    function selectAnswer(btn: HTMLButtonElement) {
      const key = btn.dataset.answerKey as 'home' | 'backup' | 'solar';
      const value = btn.dataset.answerValue as string;
      answers[key] = value;
      store.setAnswer(key, value as never);
      // Update radio visual state within this group.
      const group = root.querySelectorAll<HTMLButtonElement>(`[data-answer-key="${key}"]`);
      group.forEach((b) => b.setAttribute('aria-checked', String(b === btn)));
      // Auto-advance (UI nicety) — stay explicit in the store.
      const cur = uiStep;
      if (cur < 3) {
        store.next();
        window.setTimeout(() => showStep(cur + 1), 180);
      } else if (cur === 3 && store.isComplete()) {
        store.next();
        window.setTimeout(() => showStep(TOTAL), 180);
      }
    }

    function fmt(n: number, cur: 'USD' | 'MXN') {
      const val = cur === 'MXN' ? n * MXN_PER_USD : n;
      const loc = locale === 'es' ? 'es-MX' : 'en-US';
      return new Intl.NumberFormat(loc, {
        style: 'currency',
        currency: cur,
        maximumFractionDigits: 0,
      }).format(val);
    }

    function renderResult() {
      if (!store.isComplete()) return;
      const tiers = store.getTiers();
      // Default selection to the highlighted tier the first time we render.
      if (selectedTier === null) {
        selectedTier = tiers.find((t) => t.highlighted)?.key ?? 'recommended';
      }
      for (const tier of tiers) {
        const el = tierEls.find((e) => e.dataset.tier === tier.key);
        if (!el) continue;
        const isHighlight = tier.highlighted;
        const isSelected = tier.key === selectedTier;
        el.classList.toggle('is-highlight', isHighlight);

        const badge = el.querySelector<HTMLElement>('[data-tier-badge]');
        const nameEl = el.querySelector<HTMLElement>('[data-tier-name]');
        const coverEl = el.querySelector<HTMLElement>('[data-tier-cover]');
        const chipsEl = el.querySelector<HTMLElement>('[data-tier-chips]');
        const amountEl = el.querySelector<HTMLElement>('[data-tier-amount]');
        const ivaEl = el.querySelector<HTMLElement>('[data-tier-iva]');
        const ctaEl = el.querySelector<HTMLElement>('[data-tier-cta]');
        const btn = el.querySelector<HTMLButtonElement>('[data-tier-select]');

        if (badge) badge.hidden = !isHighlight;
        if (nameEl) nameEl.textContent = tr(TIER_NAME[tier.key]);
        if (coverEl) coverEl.textContent = tr(TIER_COVER[tier.key]);
        if (chipsEl) chipsEl.textContent = tierChips(tier.config);
        // Pre-IVA headline + a SEPARATE "+ 16% IVA (amount)" line.
        if (amountEl) amountEl.textContent = fmt(tier.price.preIvaUsd, currency);
        if (ivaEl) {
          ivaEl.textContent = tr('estimator.price_iva_line').replace('{iva}', fmt(tier.price.ivaUsd, currency));
        }
        if (ctaEl) ctaEl.textContent = isSelected ? tr('estimator.tier_selected') : tr('estimator.tier_select');
        if (btn) btn.setAttribute('aria-checked', String(isSelected));
      }
    }

    // ---- Wire up choices ----
    for (const btn of choices) {
      btn.addEventListener('click', () => selectAnswer(btn));
    }

    // ---- Tier selection ----
    for (const el of tierEls) {
      const btn = el.querySelector<HTMLButtonElement>('[data-tier-select]');
      btn?.addEventListener('click', () => {
        selectedTier = (btn.dataset.tierSelect as Tier['key']) ?? selectedTier;
        renderResult();
      });
    }

    backBtn?.addEventListener('click', () => {
      const target = Math.max(1, uiStep - 1);
      store.back();
      showStep(target);
    });

    restartBtn?.addEventListener('click', () => {
      // Reset store + UI.
      store = createEstimator({
        pricing: null,
        leadClient: (p: LeadPayload) => submitLead(baseUrl, p),
      });
      for (const k of Object.keys(answers)) delete answers[k];
      selectedTier = null;
      root.querySelectorAll('[data-answer-key]').forEach((b) => b.setAttribute('aria-checked', 'false'));
      if (form) form.hidden = false;
      if (okState) okState.hidden = true;
      if (errState) errState.hidden = true;
      showStep(1);
      // Re-fetch pricing for the fresh store (cached, so cheap).
      fetchPricing(baseUrl).then((pricing) => {
        const fresh = createEstimator({ pricing, leadClient: (p: LeadPayload) => submitLead(baseUrl, p) });
        store = fresh;
      });
    });

    // ---- Currency toggle ----
    for (const cb of curBtns) {
      cb.addEventListener('click', () => {
        currency = (cb.dataset.currency as 'USD' | 'MXN') ?? 'USD';
        curBtns.forEach((b) => {
          const on = b === cb;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-checked', String(on));
        });
        renderResult();
      });
    }

    // ---- Capture form ----
    function syncSubmit() {
      if (!submitBtn) return;
      const can = store.canSubmit({
        name: nameInput?.value ?? '',
        contact: contactInput?.value ?? '',
      });
      submitBtn.disabled = !can;
    }
    nameInput?.addEventListener('input', syncSubmit);
    contactInput?.addEventListener('input', syncSubmit);

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitBtn) submitBtn.disabled = true;
      const res = await store.submit({
        name: nameInput?.value ?? '',
        contact: contactInput?.value ?? '',
        locale,
        selectedTier: selectedTier ?? undefined,
        hp: hpInput?.value ?? '',
      });
      if (res.ok) {
        if (form) form.hidden = true;
        if (okState) okState.hidden = false;
        okState?.focus?.();
      } else {
        // Submission failed (no endpoint / network) → surface WhatsApp fallback.
        if (errState) errState.hidden = false;
        if (submitBtn) submitBtn.disabled = false;
      }
    });

    // Initial paint.
    showStep(1);
  }
</script>
