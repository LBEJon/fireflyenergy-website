---
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---
<section id="equipment" class="ff-eq" aria-labelledby="ff-eq-title">
  <div class="ff-eq__inner">
    <header class="ff-eq__head">
      <p class="ff-eq__eyebrow">{t(locale, 'equipment.eyebrow')}</p>
      <h2 id="ff-eq-title" class="ff-eq__title display">{t(locale, 'equipment.title')}</h2>
      <p class="ff-eq__sub">{t(locale, 'equipment.sub')}</p>
    </header>

    <figure class="ff-eq__stage">
      <picture>
        <source type="image/webp" srcset="/assets/equipment/system-installed.webp" />
        <img
          class="ff-eq__photo"
          src="/assets/equipment/system-installed.jpg"
          alt={t(locale, 'equipment.installed_alt')}
          width="1600"
          height="1067"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </figure>
  </div>
</section>

<style>
  .ff-eq { background: var(--ff-paper); padding: var(--sp-7) var(--sp-3); }
  .ff-eq__inner { max-width: var(--container); margin: 0 auto; }
  .ff-eq__head { max-width: var(--container-tight); margin: 0 auto var(--sp-5); text-align: center; }
  .ff-eq__eyebrow {
    text-transform: uppercase; letter-spacing: 0.12em; font-size: var(--fs-eyebrow);
    font-weight: 700; color: var(--ff-accent-dk); margin: 0 0 var(--sp-2);
  }
  .ff-eq__title { font-size: var(--fs-h1); line-height: var(--lh-snug); margin: 0 0 var(--sp-2); }
  .ff-eq__sub { font-size: var(--fs-lead); color: var(--ff-slate); margin: 0; }

  /* ---- Stage: a photoreal in-home install shot ---- */
  .ff-eq__stage {
    position: relative;
    margin: 0;
    aspect-ratio: 3 / 2;
    width: 100%;
    border: 1px solid var(--ff-line);
    border-radius: var(--r-lg, 22px);
    box-shadow: var(--shadow-md, 0 18px 40px rgba(42, 45, 52, 0.1));
    overflow: hidden;
    background: var(--ff-mist);
  }
  .ff-eq__photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 600px) {
    .ff-eq__stage { aspect-ratio: 4 / 3; border-radius: 16px; }
  }
</style>
