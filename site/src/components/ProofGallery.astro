---
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// Real Firefly installs (retouched: decluttered + Firefly-branded). 5 photos.
const installs = [1, 2, 3, 4, 5];
const alt = t(locale, 'proof.install_alt');
---
<section class="ff-proof">
  <div class="ff-proof__inner">
    <header class="ff-proof__head">
      <p class="ff-proof__eyebrow">{t(locale, 'proof.eyebrow')}</p>
      <h2 class="ff-proof__title display">{t(locale, 'proof.title')}</h2>
      <p class="ff-proof__sub">{t(locale, 'proof.sub')}</p>
    </header>

    <div class="ff-proof__carousel">
      <ul class="ff-proof__rail" data-rail>
        {installs.map((n) => (
          <li class="ff-proof__card">
            <img class="ff-proof__img" src={`/assets/equipment/installs/install-${n}.jpg`} alt={alt} width="1200" height="1600" loading="lazy" decoding="async" />
          </li>
        ))}
      </ul>
      <div class="ff-proof__nav">
        <button type="button" class="ff-proof__arrow" data-prev aria-label={t(locale, 'proof.prev')}>‹</button>
        <button type="button" class="ff-proof__arrow" data-next aria-label={t(locale, 'proof.next')}>›</button>
      </div>
    </div>
  </div>
</section>

<style>
  .ff-proof { background: var(--ff-mist); padding: var(--sp-7) var(--sp-3); }
  .ff-proof__inner { max-width: var(--container); margin: 0 auto; }
  .ff-proof__head { max-width: var(--container-tight); margin: 0 auto var(--sp-5); text-align: center; }
  .ff-proof__eyebrow {
    text-transform: uppercase; letter-spacing: 0.12em; font-size: var(--fs-eyebrow);
    font-weight: 700; color: var(--ff-accent-dk); margin: 0 0 var(--sp-2);
  }
  .ff-proof__title { font-size: var(--fs-h1); line-height: var(--lh-snug); margin: 0 0 var(--sp-2); }
  .ff-proof__sub { font-size: var(--fs-lead); color: var(--ff-slate); margin: 0; }

  .ff-proof__carousel { position: relative; }
  .ff-proof__rail {
    list-style: none; margin: 0; padding: 0 0 var(--sp-2);
    display: flex; gap: var(--sp-3); align-items: flex-start;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch; scrollbar-width: none;
  }
  .ff-proof__rail::-webkit-scrollbar { display: none; }
  .ff-proof__card { flex: 0 0 auto; width: clamp(220px, 60vw, 300px); scroll-snap-align: center; margin: 0; }
  .ff-proof__img {
    /* images are exactly 3:4 — size to the file, no crop, no stretch */
    display: block; width: 100%; height: auto;
    border-radius: var(--r-lg); box-shadow: var(--shadow-md); background: var(--ff-mist);
  }
  .ff-proof__nav { display: flex; justify-content: center; gap: var(--sp-2); margin-top: var(--sp-3); }
  .ff-proof__arrow {
    width: 44px; height: 44px; border-radius: var(--r-pill);
    border: 1px solid var(--ff-line); background: var(--ff-white); color: var(--ff-ink);
    font-size: 1.5rem; line-height: 1; cursor: pointer;
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .ff-proof__arrow:hover { border-color: var(--ff-ink); transform: translateY(-1px); }
</style>

<script>
  for (const root of document.querySelectorAll('.ff-proof__carousel')) {
    const rail = root.querySelector<HTMLElement>('[data-rail]');
    if (!rail) continue;
    const step = () => (rail.querySelector<HTMLElement>('.ff-proof__card')?.offsetWidth ?? 300) + 16;
    root.querySelector('[data-prev]')?.addEventListener('click', () => rail.scrollBy({ left: -step(), behavior: 'smooth' }));
    root.querySelector('[data-next]')?.addEventListener('click', () => rail.scrollBy({ left: step(), behavior: 'smooth' }));
  }
</script>
