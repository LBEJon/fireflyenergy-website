---
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// Simple inline-SVG icons keyed by card.
const icons: Record<string, string> = {
  outage:
    '<path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/>',
  weak:
    '<path d="M3 12h4l2 6 4-12 2 6h6"/>',
  quality:
    '<path d="M12 3a9 9 0 1 0 9 9"/><path d="M12 7v5l3 2"/>',
  spike:
    '<path d="M3 12h3l3-7 4 14 3-7h5"/>',
  long:
    '<path d="M5 8h11v8H5z"/><path d="M16 11h3v2h-3z"/><path d="M8 8V6h5v2"/>',
  flicker:
    '<path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4.5 12.6c.5.4.9 1 1 1.7l.2 1.2h6.6l.2-1.2c.1-.7.5-1.3 1-1.7A7 7 0 0 0 12 2z"/>',
};

// All six protections, shown together in a 3×2 grid (no expand/collapse).
const cards = [
  { k: 'outage', title: t(locale, 'defense.c1_title'), body: t(locale, 'defense.c1_body') },
  { k: 'weak', title: t(locale, 'defense.c2_title'), body: t(locale, 'defense.c2_body') },
  { k: 'quality', title: t(locale, 'defense.c3_title'), body: t(locale, 'defense.c3_body') },
  { k: 'spike', title: t(locale, 'defense.c4_title'), body: t(locale, 'defense.c4_body') },
  { k: 'long', title: t(locale, 'defense.c5_title'), body: t(locale, 'defense.c5_body') },
  { k: 'flicker', title: t(locale, 'defense.c6_title'), body: t(locale, 'defense.c6_body') },
];

// System-level specs — presented as a confident stat band rather than a chip line.
const stats = [
  { num: t(locale, 'defense.stat_resp_num'), label: t(locale, 'defense.stat_resp_label') },
  { num: t(locale, 'defense.stat_mon_num'), label: t(locale, 'defense.stat_mon_label') },
  { num: t(locale, 'defense.stat_auto_num'), label: t(locale, 'defense.stat_auto_label') },
  { num: t(locale, 'defense.stat_uptime_num'), label: t(locale, 'defense.stat_uptime_label') },
];
---
<section class="ff-defense">
  <div class="ff-defense__inner">
    <header class="ff-defense__head">
      <p class="ff-defense__eyebrow">{t(locale, 'defense.eyebrow')}</p>
      <h2 class="ff-defense__title display">{t(locale, 'defense.title')}</h2>
      <p class="ff-defense__sub">{t(locale, 'defense.sub')}</p>
    </header>

    <div class="ff-defense__grid">
      {cards.map((c) => (
        <article class="ff-defense__card">
          <span class="ff-defense__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[c.k]} />
          </span>
          <h3>{c.title}</h3>
          <p>{c.body}</p>
        </article>
      ))}
    </div>

    <div class="ff-defense__stats">
      <p class="ff-defense__stats-lead">{t(locale, 'defense.stats_lead')}</p>
      <dl class="ff-defense__stats-grid">
        {stats.map((s) => (
          <div class="ff-defense__stat">
            <dt class="ff-defense__stat-num display">{s.num}</dt>
            <dd class="ff-defense__stat-label">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .ff-defense { background: var(--ff-paper); padding: var(--sp-7) var(--sp-3); }
  .ff-defense__inner { max-width: var(--container); margin: 0 auto; }
  .ff-defense__head { max-width: var(--container-tight); margin: 0 auto var(--sp-5); text-align: center; }
  .ff-defense__eyebrow {
    text-transform: uppercase; letter-spacing: 0.12em; font-size: var(--fs-eyebrow);
    font-weight: 700; color: var(--ff-accent-dk); margin: 0 0 var(--sp-2);
  }
  .ff-defense__title { font-size: var(--fs-h1); line-height: var(--lh-snug); margin: 0 0 var(--sp-2); }
  .ff-defense__sub { font-size: var(--fs-lead); color: var(--ff-slate); margin: 0; }

  .ff-defense__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-3);
  }
  .ff-defense__card {
    background: var(--ff-white);
    border: 1px solid var(--ff-line);
    border-radius: var(--r-md);
    padding: var(--sp-3);
    box-shadow: var(--shadow-sm);
  }
  .ff-defense__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px; height: 48px;
    border-radius: var(--r-sm);
    background: var(--ff-green-tint);
    color: var(--ff-ink);
    margin-bottom: var(--sp-2);
  }
  .ff-defense__card h3 { font-size: var(--fs-h3); margin: 0 0 0.4rem; }
  .ff-defense__card p { margin: 0; color: var(--ff-slate); line-height: var(--lh-body); }

  /* System-level specs as one confident band (replaces the old chip line). */
  .ff-defense__stats {
    margin: var(--sp-6) auto 0;
    max-width: var(--container-tight);
    background: var(--ff-white);
    border: 1px solid var(--ff-line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm);
    padding: var(--sp-5) var(--sp-4);
    text-align: center;
  }
  .ff-defense__stats-lead {
    max-width: 52ch;
    margin: 0 auto var(--sp-4);
    color: var(--ff-slate);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
  }
  .ff-defense__stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-3);
    margin: 0;
  }
  .ff-defense__stat {
    padding: 0 var(--sp-2);
    border-left: 1px solid var(--ff-line);
  }
  .ff-defense__stat:first-child { border-left: 0; }
  .ff-defense__stat-num {
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    font-weight: 800;
    line-height: 1;
    color: var(--ff-accent-dk);
    margin: 0;
  }
  .ff-defense__stat-label {
    margin: 0.5rem 0 0;
    font-size: var(--fs-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ff-slate);
  }

  @media (max-width: 860px) {
    .ff-defense__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .ff-defense__stats { padding: var(--sp-4) var(--sp-3); }
    .ff-defense__stats-grid { grid-template-columns: 1fr 1fr; gap: var(--sp-3) var(--sp-2); }
    /* Reset borders, then divide the 2×2 grid cleanly. */
    .ff-defense__stat { border-left: 0; padding: var(--sp-2) var(--sp-1); }
    .ff-defense__stat:nth-child(even) { border-left: 1px solid var(--ff-line); }
    .ff-defense__stat:nth-child(n + 3) { border-top: 1px solid var(--ff-line); }
  }
</style>
