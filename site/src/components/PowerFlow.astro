---
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// The diagram is a self-contained, animated, bilingual SVG (ported from the CRM
// proposal). It runs in its own document and reports its height via postMessage,
// so we frame it in an auto-resizing iframe using its built-in embed mode.
const src = `/diagram/power-flow.html?embed&lang=${locale}`;
---
<section id="how-it-works" class="ff-flow" aria-labelledby="ff-flow-title">
  <div class="ff-flow__inner">
    <header class="ff-flow__head">
      <p class="ff-flow__eyebrow">{t(locale, 'flow.eyebrow')}</p>
      <h2 id="ff-flow-title" class="ff-flow__title display">{t(locale, 'flow.title')}</h2>
      <p class="ff-flow__sub">{t(locale, 'flow.sub')}</p>
    </header>

    <div class="ff-flow__frame-wrap">
      <iframe
        id="ff-flow-frame"
        class="ff-flow__frame"
        src={src}
        title={t(locale, 'flow.diagram_aria')}
        loading="lazy"
        scrolling="no"
      ></iframe>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const frame = document.getElementById('ff-flow-frame');
    if (!frame) return;
    // The embedded diagram posts { fireflyFlowHeight } on load/resize. Match only
    // messages coming from our own iframe's window, then size the frame to fit.
    window.addEventListener('message', function (e) {
      if (e.source !== frame.contentWindow) return;
      const h = e.data && e.data.fireflyFlowHeight;
      if (typeof h === 'number' && h > 0) frame.style.height = h + 'px';
    });
  })();
</script>

<style>
  .ff-flow {
    background: var(--ff-paper);
    padding: var(--sp-7) var(--sp-3);
  }
  .ff-flow__inner {
    max-width: var(--container);
    margin: 0 auto;
  }
  .ff-flow__head {
    text-align: center;
    max-width: 820px;
    margin: 0 auto var(--sp-5);
  }
  .ff-flow__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-eyebrow);
    font-weight: 700;
    color: var(--ff-accent-dk);
    margin: 0 0 var(--sp-2);
  }
  .ff-flow__title {
    font-size: var(--fs-h1);
    line-height: var(--lh-snug);
    margin: 0 0 var(--sp-2);
  }
  .ff-flow__sub {
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--ff-slate);
    margin: 0;
  }
  .ff-flow__frame-wrap {
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }
  .ff-flow__frame {
    display: block;
    width: 100%;
    height: 720px;        /* initial; replaced by the diagram's reported height */
    border: 0;
    background: transparent;
  }
</style>
