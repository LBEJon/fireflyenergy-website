---
// TEMPORARY Phase 2 verification page. Underscore prefix = not routed in build.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import DefenseCards from '../components/DefenseCards.astro';
import FlowDiagram from '../components/FlowDiagram.astro';
import ProofGallery from '../components/ProofGallery.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
import WhatsAppBubble from '../components/WhatsAppBubble.astro';
import { getLocale } from '../lib/i18n';

const locale = getLocale(Astro.url);
---
<Base title="Phase 2 demo" description="Component demo" locale={locale} path="">
  <Nav locale={locale} />
  <main>
    <Hero locale={locale} />
    <TrustStrip locale={locale} />
    <FlowDiagram locale={locale} />
    <DefenseCards locale={locale} />
    <ProofGallery locale={locale} />
    <CTASection locale={locale} />
  </main>
  <Footer locale={locale} />
  <WhatsAppBubble locale={locale} />
</Base>
