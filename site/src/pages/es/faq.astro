---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/home/SiteNav.astro';
import Faq from '../../components/Faq.astro';
import CTASection from '../../components/CTASection.astro';
import SiteFooter from '../../components/home/SiteFooter.astro';
import '../../styles/v2.css';
import WhatsAppBubble from '../../components/WhatsAppBubble.astro';
import { faqData, faqJsonLd } from '../../lib/faqData';

const locale = 'es' as const;
const { title, description } = faqData[locale].meta;
const jsonLd = faqJsonLd(locale);
---

<Base title={title} description={description} locale={locale} path="faq" jsonLd={jsonLd}>
  <SiteNav locale={locale} path="faq" />
  <main id="main" class="page-main">
    <Faq locale={locale} />
  </main>
  <CTASection locale={locale} />
  <SiteFooter locale={locale} />
  <WhatsAppBubble locale={locale} />
</Base>

<script>
  import { initMotion } from '../../lib/motion';
  initMotion();
</script>
