---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Faq from '../../components/Faq.astro';
import CTASection from '../../components/CTASection.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppBubble from '../../components/WhatsAppBubble.astro';
import { faqData, faqJsonLd } from '../../lib/faqData';

const locale = 'es' as const;
const { title, description } = faqData[locale].meta;
const jsonLd = faqJsonLd(locale);
---

<Base title={title} description={description} locale={locale} path="faq" jsonLd={jsonLd}>
  <Nav locale={locale} />
  <main>
    <Faq locale={locale} />
  </main>
  <CTASection locale={locale} />
  <Footer locale={locale} />
  <WhatsAppBubble locale={locale} />
</Base>

<script>
  import { initMotion } from '../../lib/motion';
  initMotion();
</script>
