---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/home/SiteNav.astro';
import IndustrialHero from '../components/industrial/IndustrialHero.astro';
import Propositions from '../components/industrial/Propositions.astro';
import ScaleBand from '../components/industrial/ScaleBand.astro';
import IndustrialEquipment from '../components/industrial/IndustrialEquipment.astro';
import EngagementPath from '../components/industrial/EngagementPath.astro';
import AssessmentForm from '../components/industrial/AssessmentForm.astro';
import SiteFooter from '../components/home/SiteFooter.astro';
import '../styles/v2.css';
import WhatsAppBubble from '../components/WhatsAppBubble.astro';
import { t } from '../lib/i18n';
import { serviceGraph } from '../lib/jsonld';

const locale = 'en' as const;
const title = t(locale, 'industrial.meta_title');
const description = t(locale, 'industrial.meta_desc');
const jsonLd = serviceGraph(locale, Astro.site);
const baseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
---

<Base title={title} description={description} locale={locale} path="industrial" jsonLd={jsonLd}>
  <SiteNav locale={locale} path="industrial" />
  <main id="main" class="page-main">
    <IndustrialHero locale={locale} />
    <Propositions locale={locale} />
    <ScaleBand locale={locale} />
    <IndustrialEquipment locale={locale} />
    <EngagementPath locale={locale} />
    <AssessmentForm locale={locale} baseUrl={baseUrl} />
  </main>
  <SiteFooter locale={locale} />
  <WhatsAppBubble locale={locale} />
</Base>

<script>
  import { initMotion } from '../lib/motion';
  initMotion();
</script>
