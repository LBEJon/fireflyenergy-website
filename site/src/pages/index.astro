---
import Base from '../layouts/Base.astro';
import { getLocale } from '../lib/i18n';

const locale = getLocale(Astro.url);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Firefly Energy',
  url: 'https://fireflyenergy.mx',
};
---
<Base
  title="Firefly Energy"
  description="Solar and battery backup for homes and businesses in Mexico."
  locale={locale}
  path=""
  jsonLd={jsonLd}
>
  <main>
    <h1 class="display">Firefly Energy</h1>
    <p>Redesign in progress.</p>
  </main>
</Base>
